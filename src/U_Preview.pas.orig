Procedure TPreview3D.UpdateMultiSelCaption;
begin
 if MultiSelMode then
  Caption:='3D Preview - Multiselect surfaces ('+IntToStr(JedMain.sfsel.Count)+' selected)'
 else Caption:='3D Preview';
end;

{Multiselect surface mode: every click on a surface toggles it in the surface
 multiselection (same as Shift+Click) so many surfaces can be picked without
 holding Shift. Texture commands (e.g. Alt+< / Alt+> scale) then act on all of them.}
Procedure TPreview3D.SelectInBox(x1,y1,x2,y2:integer;add:boolean);
var sc,sf,q,n,t:integer;
    surf:TJKSurface;
    vx:TJKVertex;
    cx,cy,cz,sx,sy:double;
    found:TList;
    lsc,lsf,i:integer;
begin
 if Render3D=nil then exit;
 if x1>x2 then begin t:=x1;x1:=x2;x2:=t; end;
 if y1>y2 then begin t:=y1;y1:=y2;y2:=t; end;
 found:=TList.Create;
 try
  for sc:=0 to Level.Sectors.Count-1 do
   for sf:=0 to Level.Sectors[sc].Surfaces.Count-1 do
   begin
    surf:=Level.Sectors[sc].Surfaces[sf];
    n:=surf.Vertices.Count;
    if (n<3) or (surf.Material='') then continue;
    cx:=0;cy:=0;cz:=0;
    for q:=0 to n-1 do
    begin
     vx:=surf.GetVXs.GetItem(q);
     cx:=cx+vx.x;cy:=cy+vx.y;cz:=cz+vx.z;
    end;
    cx:=cx/n;cy:=cy/n;cz:=cz/n;
    // only surfaces facing the camera (normals point into the sector)
    if surf.normal.dx*(Render3D.CamX-cx)+surf.normal.dy*(Render3D.CamY-cy)+surf.normal.dz*(Render3D.CamZ-cz)<=0 then continue;
    if not Render3D.ProjectToScreen(cx,cy,cz,sx,sy) then continue;
    if (sx<x1) or (sx>x2) or (sy<y1) or (sy>y2) then continue;
    found.Add(Pointer(sc*65536+sf));
   end;

  if found.Count=0 then exit;
  JedMain.SetMapMode(MM_SF);
  if not add then JedMain.sfsel.Clear;
  lsc:=0;lsf:=0;
  for i:=0 to found.Count-1 do
  begin
   lsc:=integer(found[i]) div 65536;
   lsf:=integer(found[i]) mod 65536;
   JedMain.sfsel.AddSF(lsc,lsf);
  end;
  JedMain.SetCurSF(lsc,lsf);
  UpdateMultiSelCaption;
  ShowSurfPanel;
  JedMain.Invalidate;
 finally
  found.Free;
 end;
end;

Procedure TPreview3D.SubdivideClick(Sender:TObject);
var s:string;
    p,nu,nv:integer;
begin
 if SubdivStr='' then SubdivStr:='2x2';
 s:=SubdivStr;
 if not InputQuery('Subdivide surfaces','Split each selected surface into columns x rows (e.g. 2x2 or 4x1):',s) then exit;
 SubdivStr:=s;
 s:=LowerCase(Trim(s));
 p:=Pos('x',s);
 if p>0 then
 begin
  nu:=StrToIntDef(Trim(Copy(s,1,p-1)),1);
  nv:=StrToIntDef(Trim(Copy(s,p+1,20)),1);
 end else
 begin
  nu:=StrToIntDef(s,1);
  nv:=nu;
 end;
 if (nu<1) or (nv<1) or ((nu=1) and (nv=1)) then exit;
 JedMain.SetMapMode(MM_SF);
 JedMain.SurfSubdivide(nu,nv);
 UpdateMultiSelCaption;
 ShowSurfPanel;
 Invalidate;
end;

Procedure TPreview3D.SetMultiSelMode(enable:boolean);
begin
 MultiSelMode:=enable;
 miMultiSel.Checked:=enable;
 if enable then
 begin
  if JedMain.Map_mode<>MM_SF then JedMain.SetMapMode(MM_SF);
 end
 else JedMain.ClearMultiSelection;
 UpdateMultiSelCaption;
 Invalidate;
end;

procedure TPreview3D.MultiSelModeClick(Sender: TObject);
begin
 SetMultiSelMode(not MultiSelMode);
end;


{ ---- Surface edit panel ---- }

Function TPreview3D.MakePanelLabel(const cap:string;x,y:integer):TLabel;
begin
 Result:=TLabel.Create(Self);
 Result.Parent:=PnlSurf;
 Result.Caption:=cap;
 Result.Left:=x;
 Result.Top:=y+4;
 Result.Transparent:=true;
end;

Function TPreview3D.MakePanelEdit(x,y,w,tag:integer):TEdit;
begin
 Result:=TEdit.Create(Self);
 Result.Parent:=PnlSurf;
 Result.SetBounds(x,y,w,21);
 Result.Tag:=tag;
 Result.TabStop:=false;   // the form must not put the keyboard focus here by itself, camera keys would stop working
 Result.OnKeyPress:=SurfPanelEditKeyPress;
end;

Function TPreview3D.MakePanelButton(const cap:string;x,y,w,tag:integer):TButton;
begin
 Result:=TButton.Create(Self);
 Result.Parent:=PnlSurf;
 Result.SetBounds(x,y,w,21);
 Result.Caption:=cap;
 Result.Tag:=tag;
 Result.TabStop:=false;
 Result.OnClick:=SurfPanelButtonClick;
end;

Procedure TPreview3D.BuildSurfPanel;
begin
 PnlSurf:=TPanel.Create(Self);
 With PnlSurf do
 begin
  Parent:=Self;
  Align:=alBottom;
  Height:=80;
  BevelOuter:=bvRaised;
  Caption:='';
  Visible:=false;
  ShowHint:=true;
 end;

 // row 1: scale
 MakePanelLabel('Scale  U',4,4);
 edScU:=MakePanelEdit(56,4,52,11);
 MakePanelLabel('V',114,4);
 edScV:=MakePanelEdit(126,4,52,12);
 chkLink:=TCheckBox.Create(Self);
 With chkLink do
 begin
  Parent:=PnlSurf;
  SetBounds(186,6,52,17);
  TabStop:=false;
  Caption:='Link';
  Hint:='Typing a scale value sets both U and V';
  ShowHint:=true;
 end;
 MakePanelButton('+',242,4,26,1).Hint:='Scale step up (same as Alt+>)';
 MakePanelButton('-',270,4,26,2).Hint:='Scale step down (same as Alt+<)';

 // row 2: offset and rotation
 MakePanelLabel('Offset U',4,29);
 edOffU:=MakePanelEdit(56,29,52,13);
 MakePanelLabel('V',114,29);
 edOffV:=MakePanelEdit(126,29,52,14);
 MakePanelLabel('Rot',186,29);
 edRot:=MakePanelEdit(208,29,36,15);
 edRot.Text:='15';
 MakePanelButton('<',246,29,24,3).Hint:='Rotate texture left by the angle';
 MakePanelButton('>',272,29,24,4).Hint:='Rotate texture right by the angle';

 // row 3: mapping
 MakePanelLabel('Mapping',4,54);
 cbMap:=TComboBox.Create(Self);
 With cbMap do
 begin
  Parent:=PnlSurf;
  SetBounds(56,54,122,21);
  Style:=csDropDownList;
  TabStop:=false;
  Items.Add('Planar (current surface)');
  Items.Add('Box (nearest axis)');
  Items.Add('Cylindrical');
  Items.Add('Spherical');
  Items.Add('Dome (top-down, no pinch)');
  Items.Add('Spherical (no fins)');
  ItemIndex:=0;
  OnExit:=nil;
 end;
 MakePanelButton('Apply',186,54,50,5);
 MakePanelButton('Hide',246,54,50,6);
end;

Function TPreview3D.PanelVal(ed:TEdit;var d:double):boolean;
begin
 Result:=feValDouble(ed.Text,d);
end;

Procedure TPreview3D.RefreshSurfPanel;
var us,vs,ou,ov:double;
begin
 if PnlSurf=nil then exit;
 if not JedMain.SurfGetInfo(us,vs,ou,ov) then exit;
 edScU.Text:=FloatToStrF(us,ffGeneral,5,0);
 edScV.Text:=FloatToStrF(vs,ffGeneral,5,0);
 edOffU.Text:=FloatToStrF(ou,ffGeneral,6,0);
 edOffV.Text:=FloatToStrF(ov,ffGeneral,6,0);
end;

Procedure TPreview3D.ShowSurfPanel;
begin
 if PnlSurf=nil then exit;
 // never leave the keyboard focus in the panel when it opens
 if (ActiveControl<>nil) and (ActiveControl.Parent=PnlSurf) then ActiveControl:=nil;
 RefreshSurfPanel;
 if not PnlSurf.Visible then
 begin
  PnlSurf.Top:=StatusBar1.Top-PnlSurf.Height;   // above the status bar
  PnlSurf.Visible:=true;
 end;
end;

Procedure TPreview3D.HideSurfPanel;
begin
 if PnlSurf=nil then exit;
 if ActiveControl<>nil then ActiveControl:=nil;
 PnlSurf.Visible:=false;
end;

procedure TPreview3D.SurfPanelEditKeyPress(Sender: TObject; var Key: Char);
var a,b,us,vs,ou,ov:double;
begin
 if Key<>#13 then exit;
 Key:=#0;
 case (Sender as TEdit).Tag of
  11: if PanelVal(edScU,a) then
       if chkLink.Checked then JedMain.SurfScaleSet(a,a,true,true)
       else JedMain.SurfScaleSet(a,0,true,false);
  12: if PanelVal(edScV,a) then
       if chkLink.Checked then JedMain.SurfScaleSet(a,a,true,true)
       else JedMain.SurfScaleSet(0,a,false,true);
  13,14: if PanelVal(edOffU,a) and PanelVal(edOffV,b) then
          if JedMain.SurfGetInfo(us,vs,ou,ov) then JedMain.SurfOffsetBy(a-ou,b-ov);
  15: if PanelVal(edRot,a) then JedMain.SurfRotateBy(a);
 end;
 RefreshSurfPanel;
 ActiveControl:=nil;
 Invalidate;
end;

procedure TPreview3D.SurfPanelButtonClick(Sender: TObject);
var a:double;
begin
 case (Sender as TButton).Tag of
  1: JedMain.SurfScaleStep(true);
  2: JedMain.SurfScaleStep(false);
  3: if PanelVal(edRot,a) then JedMain.SurfRotateBy(-a);
  4: if PanelVal(edRot,a) then JedMain.SurfRotateBy(a);
  5: JedMain.SurfProject(cbMap.ItemIndex);
  6: begin HideSurfPanel; Invalidate; exit; end;
 end;
 RefreshSurfPanel;
 ActiveControl:=nil;
 Invalidate;
end;

// The main window has a menu item with the plain Z key as its shortcut (Grid to View). Menu shortcuts are
// looked at before the key reaches FormKeyDown, so Z (camera down) never got there. Take the key here instead.
procedure TPreview3D.PreviewShortCut(var Msg: TWMKey; var Handled: Boolean);
var k:Word;
begin
 if Msg.CharCode<>Ord('Z') then exit;
 if (GetKeyState(VK_CONTROL) and $8000<>0) or (GetKeyState(VK_MENU) and $8000<>0)
    or (GetKeyState(VK_SHIFT) and $8000<>0) then exit;
 if (ActiveControl<>nil) and (ActiveControl is TCustomEdit) then exit;
 k:=Msg.CharCode;
 FormKeyDown(Self,k,[]);
 Handled:=true;
end;

procedure TPreview3D.SetViewcamera1Click(Sender: TObject);
begin
 With Render3D do JedMain.SetCam(CamX,CamY,CamZ,0,0,0);
end;

Procedure TPreview3D.AddKBItem(mi:TMenuItem;const name:string;c:char;sc:TShiftState);
var nmi:TMenuItem;
    ext:string;
begin
 nmi:=TMenuItem.Create(mi);
 nmi.OnClick:=KBCommandClick;
 case c of
  #0: ext:='';
  Char(VK_ADD):ext:=#9'+';
  Char(VK_SUBTRACT):ext:=#9'-';
  Char(VK_MULTIPLY):ext:=#9'*';
 else ext:=#9+ShortCutToText(ShortCut(ord(c),sc));
 end;

 nmi.Caption:=name+ext;
 nmi.Tag:=ShortCut(ord(c),sc);
 mi.Add(nmi);
end;

procedure TPreview3D.KBCommandClick(Sender: TObject);
var key:word;
    sc:TShiftState;
begin
 with (sender as TMenuItem) do
 begin
  ShortCutToKey(Tag,key,sc);
  FormKeyDown(Self, Key, sc);
 end;
end;



procedure TPreview3D.ToggleFullyLit1Click(Sender: TObject);
var cpos:TcamPos;
begin
 P3DFullLit:=not P3DFullLit;
 SaveCamPos(cpos);
 Self.Hide;
 ShowPreview;
 RestoreCamPos(cpos);
end;

Procedure TPreview3D.GetCam(var x,y,z,pch,yaw:double);
begin
 x:=0; y:=0; z:=0; pch:=0; yaw:=0;
 if Render3D=nil then exit;
 x:=Render3D.CamX;
 y:=Render3D.CamY;
 z:=Render3D.CamZ;
 pch:=-Render3D.PCH;
 yaw:=-Render3D.YAW;
end;


end.
