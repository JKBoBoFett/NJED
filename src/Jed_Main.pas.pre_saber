 StartUndoRec(rname);
for i:=0 to sfsel.count-1 do
 begin
  sfsel.GetSCSF(i,sc,sf);
  SaveSecUndo(Level.Sectors[sc],change,how);
 end;
 sfsel.DeleteN(n);
end;

