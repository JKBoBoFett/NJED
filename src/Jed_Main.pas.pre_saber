Const
     {Map modes}
     MM_SC=0;
     MM_SF=1;
     MM_VX=2;
     MM_TH=3;
     MM_ED=4;
     MM_LT=5;
     MM_FR=6;
     MM_Extra=10;

     {Mouse Modes}
     MM_Select=0;
     MM_Cleave=1;
     MM_Drag=2;
     MM_TranslateCam=3;
     MM_RotateCam=4;
     MM_TranslateGrid=5;
     MM_RotateGrid=6;
     MM_CreateSector=7;
     MM_RectSelect=8;

     All_layers=-100;

     {Toolbar Panel IDs}
     PI_XYZ=0;

     {ShiftTexture constants}
     st_left=0;
     st_right=1;
     st_up=2;
     st_down=3;

     {SectorChanged() constants}
     sc_vertices=1;
     sc_values=2;
     sc_all=-1;
     {ScaleObject constants}
     sc_ScaleTX=1;
     sc_scaleX=2;
     sc_scaleY=4;
     sc_scaleZ=8;
     sc_scaleGrid=16;

     ro_up=0;
     ro_down=1;
     {Cursor constants}
     crSaber=1;

     {SetThingView constants}
      cv_Dots=0;
      cv_Boxes=1;
      cv_Wireframes=2;

     {OpenProject flags}
      op_open=0;
      op_revert=1;

      {Surface texture projection kinds (3D preview surface panel)}
      sp_Planar=0;
      sp_Box=1;
      sp_Cylindrical=2;
      sp_Spherical=3;
      sp_Dome=4;
      sp_Conformal=5;

      {Multiselection modes}
      mm_Toggle=0;
      mm_Add=1;
      mm_Subtract=2;


