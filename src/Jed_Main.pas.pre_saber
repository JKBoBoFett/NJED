Procedure TJedMain.ScaleTexture(how:integer);
var du,dv:double;
    surf:TJKSurface;
    i,n,sc,sf:integer;
    u,v:TVector;

Procedure ScaleSurf(surf:TJKSurface);
begin
 SaveSecUndo(surf.sector,ch_changed,sc_geo);
 case how of
  st_up: begin
          surf.uscale:=surf.uscale*TxScaleStep;
          surf.vscale:=surf.vscale*TxScaleStep;
         end;
  st_down: begin
            surf.uscale:=surf.uscale/TxScaleStep;
            surf.vscale:=surf.vscale/TxScaleStep;
           end;
  else exit;
 end;
 CalcUVNormals(surf,u,v);
 ArrangeTexture(surf,0,u,v);
 SectorChanged(surf.sector);
end;

begin
 if map_mode<>MM_SF then SetMapMode(MM_SF);
 if not Preview3D.IsActive then exit;

 StartUndoRec('Scale texture');

 n:=sfsel.AddSF(Cur_SC,Cur_SF);

 for i:=0 to sfsel.count-1 do
 begin
  sfsel.getSCSF(i,sc,sf);
  scaleSurf(Level.Sectors[sc].Surfaces[sf]);
 end;

 sfsel.DeleteN(n);

end;



{ ---- Surface edit panel (3D preview) ---- }

// the current surface plus everything in the surface multiselection
Procedure TJedMain.GetSelSurfaces(l:TList);
var i,n,sc,sf:integer;
begin
 l.Clear;
 if (Cur_SC<0) or (Cur_SC>=Level.Sectors.Count) then exit;
 if (Cur_SF<0) or (Cur_SF>=Level.Sectors[Cur_SC].Surfaces.Count) then exit;
 n:=sfsel.AddSF(Cur_SC,Cur_SF);
 for i:=0 to sfsel.count-1 do
 begin
  sfsel.GetSCSF(i,sc,sf);
  if (sc>=0) and (sc<Level.Sectors.Count) and
     (sf>=0) and (sf<Level.Sectors[sc].Surfaces.Count) then
   l.Add(Level.Sectors[sc].Surfaces[sf]);
 end;
 sfsel.DeleteN(n);
end;

// scale and offset of the current surface (for the panel fields)
Function TJedMain.SurfGetInfo(var us,vs,ou,ov:double):boolean;
var surf:TJKSurface;
begin
 Result:=false;
 us:=1; vs:=1; ou:=0; ov:=0;
 if (Cur_SC<0) or (Cur_SC>=Level.Sectors.Count) then exit;
 if (Cur_SF<0) or (Cur_SF>=Level.Sectors[Cur_SC].Surfaces.Count) then exit;
 surf:=Level.Sectors[Cur_SC].Surfaces[Cur_SF];
 us:=surf.uscale;
 vs:=surf.vscale;
 if surf.TXVertices.Count>0 then
 begin
  ou:=surf.TXVertices[0].u;
  ov:=surf.TXVertices[0].v;
 end;
 Result:=true;
end;

// sets the scale of every selected surface to the given value (the texture is rearranged around vertex 0)
Procedure TJedMain.SurfScaleSet(us,vs:double;setU,setV:boolean);
var l:TList;
    i:integer;
    surf:TJKSurface;
    u,v:TVector;
begin
 if setU and (us<0.0001) then exit;
 if setV and (vs<0.0001) then exit;
 l:=TList.Create;
 try
  GetSelSurfaces(l);
  if l.Count=0 then exit;
  StartUndoRec('Set texture scale');
  for i:=0 to l.Count-1 do
  begin
   surf:=TJKSurface(l[i]);
   SaveSecUndo(surf.sector,ch_changed,sc_geo);
   if setU then surf.uscale:=us;
   if setV then surf.vscale:=vs;
   CalcUVNormals(surf,u,v);
   ArrangeTexture(surf,0,u,v);
   SectorChanged(surf.sector);
  end;
 finally
  l.Free;
 end;
end;

// same step as the Alt+< / Alt+> keys, for all selected surfaces
Procedure TJedMain.SurfScaleStep(up:boolean);
var l:TList;
    i:integer;
    surf:TJKSurface;
    u,v:TVector;
begin
 l:=TList.Create;
 try
  GetSelSurfaces(l);
  if l.Count=0 then exit;
  StartUndoRec('Scale texture');
  for i:=0 to l.Count-1 do
  begin
   surf:=TJKSurface(l[i]);
   SaveSecUndo(surf.sector,ch_changed,sc_geo);
   if up then
   begin
    surf.uscale:=surf.uscale*TxScaleStep;
    surf.vscale:=surf.vscale*TxScaleStep;
   end else
   begin
    surf.uscale:=surf.uscale/TxScaleStep;
    surf.vscale:=surf.vscale/TxScaleStep;
   end;
   CalcUVNormals(surf,u,v);
   ArrangeTexture(surf,0,u,v);
   SectorChanged(surf.sector);
  end;
 finally
  l.Free;
 end;
end;

Procedure TJedMain.SurfOffsetBy(du,dv:double);
var l:TList;
    i,j:integer;
    surf:TJKSurface;
begin
 if (du=0) and (dv=0) then exit;
 l:=TList.Create;
 try
  GetSelSurfaces(l);
  if l.Count=0 then exit;
  StartUndoRec('Offset texture');
  for i:=0 to l.Count-1 do
  begin
   surf:=TJKSurface(l[i]);
   SaveSecUndo(surf.sector,ch_changed,sc_geo);
   for j:=0 to surf.TXVertices.count-1 do
   With surf.TXVertices[j] do
   begin
    u:=u+du;
    v:=v+dv;
   end;
   SectorChanged(surf.sector);
  end;
 finally
  l.Free;
 end;
end;

// rotates the texture of every selected surface around its first vertex (same maths as RotateTexture)
Procedure TJedMain.SurfRotateBy(deg:double);
var l:TList;
    i:integer;
    surf:TJKSurface;
    u,v,nu,nv:TVector;
    cosa,sina:double;
begin
 if deg=0 then exit;
 cosa:=cos(deg*pi/180);
 sina:=sin(deg*pi/180);
 l:=TList.Create;
 try
  GetSelSurfaces(l);
  if l.Count=0 then exit;
  StartUndoRec('Rotate texture');
  for i:=0 to l.Count-1 do
  begin
   surf:=TJKSurface(l[i]);
   SaveSecUndo(surf.sector,ch_changed,sc_geo);
   CalcUVNormals(surf,u,v);

   nv.dx:=-sina*u.dx+cosa*v.dx;
   nv.dy:=-sina*u.dy+cosa*v.dy;
   nv.dz:=-sina*u.dz+cosa*v.dz;

   nu.dx:=cosa*u.dx+sina*v.dx;
   nu.dy:=cosa*u.dy+sina*v.dy;
   nu.dz:=cosa*u.dz+sina*v.dz;

   UpdateSurfUVData(surf,nu,nv);
   ArrangeTexture(surf,0,nu,nv);
   SectorChanged(surf.sector);
  end;
 finally
  l.Free;
 end;
end;

// projects a texture onto all selected surfaces: planar (plane of the current surface),
// box (nearest axis per surface), cylindrical (around a vertical axis) or spherical
Procedure TJedMain.SurfProject(kind:integer);
var l:TList;
    i,j,cnt:integer;
    surf,csurf:TJKSurface;
    un,vn:TVector;
    vx:TJKVertex;
    minx,miny,minz,maxx,maxy,maxz,cx,cy,cz,r,d,ppu:double;
    a0,ang,lat,t:double;
    ax:TVector;
    pu,pv:double;
    angs:array of double;
    okang:array of boolean;
    nok:integer;
    sa:double;
    nrm:TVector;
    nun,nvn:TVector;               {level surfaces: the current surface's own U/V directions}
    levelPlanar:boolean;
    tx0:TTXVertex;
    usgn:double;
    useFrame:boolean;              {3DO cylindrical: work in a frame whose Z is the limb axis}
    fox,foy,foz:double;
    fe1,fe2,fe3:TVector;
    lx,ly,lz:double;
    dens3DO:double;                {texels per world unit used for 3DO surfaces}
    fitDens,seamShift,camA,cax,cay,caz,sumS,sumC,bestD,dA,seamA:double;
    texW:integer;
    rawang:array of double;

 // un/vn for a projection plane with normal n: v points down, u runs along the plane, vn = un x n
 Procedure BasisFor(const n:TVector; var bu,bv:TVector);
 var v0:TVector;
 begin
  if abs(n.dz)>0.7071 then SetVec(v0,0,-1,0) else SetVec(v0,0,0,-1);
  bu:=VCross(n,v0);
  if not Normalize(bu) then SetVec(bu,1,0,0);
  bv:=VCross(bu,n);
  Normalize(bv);
 end;

 Procedure AxisNormal(const n:TVector; var a:TVector);
 var sx,sy,sz:double;
 begin
  if n.dx<0 then sx:=-1 else sx:=1;
  if n.dy<0 then sy:=-1 else sy:=1;
  if n.dz<0 then sz:=-1 else sz:=1;
  if (abs(n.dx)>=abs(n.dy)) and (abs(n.dx)>=abs(n.dz)) then SetVec(a,sx,0,0)
  else if abs(n.dy)>=abs(n.dz) then SetVec(a,0,sy,0)
  else SetVec(a,0,0,sz);
 end;

 // keeps the angle of a vertex within +-180 degrees of the first one so a surface doesn't tear at the seam
 Function Unwrap(a,a0:double):double;
 var dd:double;
 begin
  dd:=a-a0;
  while dd>pi do dd:=dd-2*pi;
  while dd<-pi do dd:=dd+2*pi;
  Result:=a0+dd;
 end;

 // 3DO sectors: the visible side of a surface is opposite to its stored normal (the mesh is drawn with
 // reversed winding), and a model is looked at from the outside, so the projections below (which assume
 // the texture is seen from the inside of a room) would come out mirrored.
 Function Is3DOSurf(s:TJKSurface):boolean;
 begin
  Result:=(s.sector.Flags and SF_3DO)<>0;
 end;

 Function VisibleNormal(s:TJKSurface):TVector;
 begin
  Result:=s.normal;
  if Is3DOSurf(s) then SetVec(Result,-s.normal.dx,-s.normal.dy,-s.normal.dz);
 end;


 // same as Loc for a plain world position (used for the camera)
 Procedure LocXYZ(x,y,z:double;var a,b,c:double);
 var ddx,ddy,ddz:double;
 begin
  if not useFrame then
  begin
   a:=x; b:=y; c:=z;
   exit;
  end;
  ddx:=x-fox; ddy:=y-foy; ddz:=z-foz;
  a:=ddx*fe1.dx+ddy*fe1.dy+ddz*fe1.dz;
  b:=ddx*fe2.dx+ddy*fe2.dy+ddz*fe2.dz;
  c:=ddx*fe3.dx+ddy*fe3.dy+ddz*fe3.dz;
 end;

 Function TextureWidthOf(const matname:string):integer;
 var tf:TFile;
     tm:TMAT;
 begin
  Result:=0;
  try
   tf:=OpenGameFile(matname);
   if tf=nil then exit;
   tm:=TMAT.Create(tf,0);
   Result:=tm.Info.width;
   tm.Free;
  except
   Result:=0;
  end;
 end;

 // coordinates of a vertex in the projection frame (the world axes unless a limb axis frame is active)
 Procedure Loc(v:TJKVertex;var a,b,c:double);
 var ddx,ddy,ddz:double;
 begin
  if not useFrame then
  begin
   a:=v.x; b:=v.y; c:=v.z;
   exit;
  end;
  ddx:=v.x-fox; ddy:=v.y-foy; ddz:=v.z-foz;
  a:=ddx*fe1.dx+ddy*fe1.dy+ddz*fe1.dz;
  b:=ddx*fe2.dx+ddy*fe2.dy+ddz*fe2.dz;
  c:=ddx*fe3.dx+ddy*fe3.dy+ddz*fe3.dz;
 end;

 // -1 when a 3DO surface is seen from outside the projection centre (u must run the other way), else 1
 Function OutsideSign(s:TJKSurface;full3D:boolean):double;
 var q:integer;
     mx,my,mz,dd:double;
     vn3:TVector;
 begin
  Result:=1;
  if not Is3DOSurf(s) then exit;
  if s.Vertices.Count=0 then exit;
  mx:=0; my:=0; mz:=0;
  for q:=0 to s.Vertices.Count-1 do
  begin
   Loc(s.Vertices[q],lx,ly,lz);
   mx:=mx+lx; my:=my+ly; mz:=mz+lz;
  end;
  mx:=mx/s.Vertices.Count-cx; my:=my/s.Vertices.Count-cy; mz:=mz/s.Vertices.Count-cz;
  if not full3D then mz:=0;
  vn3:=VisibleNormal(s);
  if useFrame then
   dd:=(vn3.dx*fe1.dx+vn3.dy*fe1.dy+vn3.dz*fe1.dz)*mx+
       (vn3.dx*fe2.dx+vn3.dy*fe2.dy+vn3.dz*fe2.dz)*my+
       (vn3.dx*fe3.dx+vn3.dy*fe3.dy+vn3.dz*fe3.dz)*mz
  else dd:=vn3.dx*mx+vn3.dy*my+vn3.dz*mz;
  if dd>=0 then Result:=-1;
 end;


 // Texel density of a 3DO surface (texture pixels per world unit) measured along its edges from its UVs.
 // Imported 3DO surfaces can carry meaningless uscale/vscale (huge or tiny values), which would wreck every
 // projection, so the density is taken from the model itself: the median over the other surfaces that use
 // the same texture, falling back to the selection and then to the level's pixels per unit.
 Function SurfDensity(s:TJKSurface;var dens:double):boolean;
 var q,nq:integer;
     ul,wl,du,dv,wx,wy,wz:double;
     v1,v2:TJKVertex;
     t1,t2:TTXVertex;
 begin
  Result:=false;
  ul:=0; wl:=0;
  nq:=s.Vertices.Count;
  if nq<3 then exit;
  for q:=0 to nq-1 do
  begin
   v1:=s.Vertices[q]; v2:=s.Vertices[(q+1) mod nq];
   t1:=s.TXVertices[q]; t2:=s.TXVertices[(q+1) mod nq];
   wx:=v2.x-v1.x; wy:=v2.y-v1.y; wz:=v2.z-v1.z;
   du:=t2.u-t1.u; dv:=t2.v-t1.v;
   wl:=wl+sqrt(wx*wx+wy*wy+wz*wz);
   ul:=ul+sqrt(du*du+dv*dv);
  end;
  if wl<1e-9 then exit;
  dens:=ul/wl;
  Result:=(dens>1) and (dens<100000);
 end;

 Function ModelDensity:double;
 var a,b,n,sc,sf:integer;
     arr:array of double;
     d,tmp:double;
     s0,s2:TJKSurface;
 begin
  Result:=0;
  s0:=TJKSurface(l[0]);
  SetLength(arr,0);
  n:=0;
  for sc:=0 to Level.Sectors.Count-1 do
  begin
   if (Level.Sectors[sc].Flags and SF_3DO)=0 then continue;
   for sf:=0 to Level.Sectors[sc].Surfaces.Count-1 do
   begin
    s2:=Level.Sectors[sc].Surfaces[sf];
    if l.IndexOf(s2)<>-1 then continue;               // not the surfaces being mapped
    if CompareText(s2.Material,s0.Material)<>0 then continue;
    if SurfDensity(s2,d) then
    begin
     SetLength(arr,n+1); arr[n]:=d; inc(n);
    end;
   end;
  end;
  if n=0 then
   for a:=0 to l.Count-1 do
    if SurfDensity(TJKSurface(l[a]),d) then begin SetLength(arr,n+1); arr[n]:=d; inc(n); end;
  if n=0 then begin Result:=ppu; exit; end;
  for a:=1 to n-1 do      // insertion sort, then the median
  begin
   tmp:=arr[a]; b:=a-1;
   while (b>=0) and (arr[b]>tmp) do begin arr[b+1]:=arr[b]; dec(b); end;
   arr[b+1]:=tmp;
  end;
  Result:=arr[n div 2];
 end;

 // Cylindrical mapping of 3DO limbs: the cylinder axis is the long axis of the selected surfaces (principal
 // axis of their vertices) instead of the world Z axis, so a tilted arm or leg is wrapped along its own length.
 // Only used when every selected surface belongs to a 3DO sector and the selection is clearly elongated.
 Procedure SetupFrame;
 var i2,j2,cn,it:integer;
     v:TJKVertex;
     mx,my,mz,len,tr,d0,d1,d2,t2:double;
     c:array[0..2,0..2] of double;
     u,w:array[0..2] of double;
 begin
  useFrame:=false;
  if kind<>sp_Cylindrical then exit;
  mx:=0; my:=0; mz:=0; cn:=0;
  for i2:=0 to l.Count-1 do
  begin
   if not Is3DOSurf(TJKSurface(l[i2])) then exit;
   for j2:=0 to TJKSurface(l[i2]).Vertices.Count-1 do
   begin
    v:=TJKSurface(l[i2]).Vertices[j2];
    mx:=mx+v.x; my:=my+v.y; mz:=mz+v.z;
    inc(cn);
   end;
  end;
  if cn<4 then exit;
  mx:=mx/cn; my:=my/cn; mz:=mz/cn;
  for i2:=0 to 2 do for j2:=0 to 2 do c[i2,j2]:=0;
  for i2:=0 to l.Count-1 do
   for j2:=0 to TJKSurface(l[i2]).Vertices.Count-1 do
   begin
    v:=TJKSurface(l[i2]).Vertices[j2];
    d0:=v.x-mx; d1:=v.y-my; d2:=v.z-mz;
    c[0,0]:=c[0,0]+d0*d0; c[0,1]:=c[0,1]+d0*d1; c[0,2]:=c[0,2]+d0*d2;
    c[1,1]:=c[1,1]+d1*d1; c[1,2]:=c[1,2]+d1*d2; c[2,2]:=c[2,2]+d2*d2;
   end;
  c[1,0]:=c[0,1]; c[2,0]:=c[0,2]; c[2,1]:=c[1,2];
  tr:=c[0,0]+c[1,1]+c[2,2];
  if tr<1e-18 then exit;
  // power iteration: dominant eigenvector = long axis
  u[0]:=0.577; u[1]:=0.5; u[2]:=0.64;
  len:=0;
  for it:=0 to 60 do
  begin
   for i2:=0 to 2 do w[i2]:=c[i2,0]*u[0]+c[i2,1]*u[1]+c[i2,2]*u[2];
   len:=sqrt(sqr(w[0])+sqr(w[1])+sqr(w[2]));
   if len<1e-18 then exit;
   for i2:=0 to 2 do u[i2]:=w[i2]/len;
  end;
  if len<0.5*tr then exit;    // not elongated: keep the vertical axis
  // axis points up (or towards +X for a horizontal limb) so V still runs downwards
  if (u[2]<0) or ((abs(u[2])<0.2) and (u[0]<0)) then
  begin u[0]:=-u[0]; u[1]:=-u[1]; u[2]:=-u[2]; end;
  SetVec(fe3,u[0],u[1],u[2]);
  // e1 = world X made perpendicular to the axis (world Y if the axis is along X)
  t2:=fe3.dx;
  SetVec(fe1,1-t2*fe3.dx,0-t2*fe3.dy,0-t2*fe3.dz);
  len:=sqrt(sqr(fe1.dx)+sqr(fe1.dy)+sqr(fe1.dz));
  if len<1e-6 then
  begin
   t2:=fe3.dy;
   SetVec(fe1,0-t2*fe3.dx,1-t2*fe3.dy,0-t2*fe3.dz);
   len:=sqrt(sqr(fe1.dx)+sqr(fe1.dy)+sqr(fe1.dz));
  end;
  SetVec(fe1,fe1.dx/len,fe1.dy/len,fe1.dz/len);
  // e2 = e3 x e1 keeps the frame right handed (e1 x e2 = e3), same turning direction as the world frame
  SetVec(fe2,fe3.dy*fe1.dz-fe3.dz*fe1.dy,fe3.dz*fe1.dx-fe3.dx*fe1.dz,fe3.dx*fe1.dy-fe3.dy*fe1.dx);
  fox:=mx; foy:=my; foz:=mz;
  useFrame:=true;
 end;

 // least squares fit of a circle (XY, cylinder) or sphere through all vertices of the selected surfaces,
 // so partial shapes such as a dome get their real centre instead of the middle of their bounding box
 Function FitCentre(sphere:boolean;var fx,fy,fz:double):boolean;
 var m:array[0..3,0..4] of double;
     row:array[0..3] of double;
     n,a,b,c,k:integer;
     rhs,f,pivot:double;
     sx:TJKVertex;
 begin
  Result:=false;
  if sphere then n:=4 else n:=3;
  for a:=0 to 3 do for b:=0 to 4 do m[a,b]:=0;
  for a:=0 to l.Count-1 do
  for b:=0 to TJKSurface(l[a]).Vertices.Count-1 do
  begin
   sx:=TJKSurface(l[a]).Vertices[b];
   Loc(sx,lx,ly,lz);
   if sphere then
   begin
    row[0]:=lx; row[1]:=ly; row[2]:=lz; row[3]:=1;
    rhs:=sqr(lx)+sqr(ly)+sqr(lz);
   end else
   begin
    row[0]:=lx; row[1]:=ly; row[2]:=1;
    rhs:=sqr(lx)+sqr(ly);
   end;
   for c:=0 to n-1 do
   begin
    for k:=0 to n-1 do m[c,k]:=m[c,k]+row[c]*row[k];
    m[c,n]:=m[c,n]+row[c]*rhs;
   end;
  end;
  // gaussian elimination with partial pivoting
  for c:=0 to n-1 do
  begin
   k:=c;
   for a:=c+1 to n-1 do if abs(m[a,c])>abs(m[k,c]) then k:=a;
   if abs(m[k,c])<1e-9 then exit;
   if k<>c then
    for b:=0 to n do begin f:=m[c,b]; m[c,b]:=m[k,b]; m[k,b]:=f; end;
   pivot:=m[c,c];
   for a:=0 to n-1 do
   if a<>c then
   begin
    f:=m[a,c]/pivot;
    for b:=c to n do m[a,b]:=m[a,b]-f*m[c,b];
   end;
  end;
  fx:=m[0,n]/m[0,0]/2;
  fy:=m[1,n]/m[1,1]/2;
  if sphere then fz:=m[2,n]/m[2,2]/2;
  // radius^2 = d + centre^2 must be sensible
  if sphere then rhs:=m[3,n]/m[3,3]+sqr(fx)+sqr(fy)+sqr(fz)
  else rhs:=m[2,n]/m[2,2]+sqr(fx)+sqr(fy);
  Result:=rhs>1e-8;
 end;

begin
 l:=TList.Create;
 try
  GetSelSurfaces(l);
  if l.Count=0 then exit;
  ppu:=PixelPerUnit;
  dens3DO:=0;
  if Is3DOSurf(TJKSurface(l[0])) then dens3DO:=ModelDensity;
  SetupFrame;

  // centre and mean radius of the selection (cylinder and sphere)
  minx:=1e30; miny:=1e30; minz:=1e30; maxx:=-1e30; maxy:=-1e30; maxz:=-1e30;
  for i:=0 to l.Count-1 do
  begin
   surf:=TJKSurface(l[i]);
   for j:=0 to surf.Vertices.Count-1 do
   begin
    vx:=surf.Vertices[j];
    Loc(vx,lx,ly,lz);
    if lx<minx then minx:=lx; if lx>maxx then maxx:=lx;
    if ly<miny then miny:=ly; if ly>maxy then maxy:=ly;
    if lz<minz then minz:=lz; if lz>maxz then maxz:=lz;
   end;
  end;
  cx:=(minx+maxx)/2; cy:=(miny+maxy)/2; cz:=(minz+maxz)/2;
  if (kind=sp_Spherical) or (kind=sp_Dome) or (kind=sp_Conformal) then FitCentre(true,cx,cy,cz)
  else if kind=sp_Cylindrical then FitCentre(false,cx,cy,sa);   // axis stays vertical, z only offsets V
  r:=0; cnt:=0;
  for i:=0 to l.Count-1 do
  begin
   surf:=TJKSurface(l[i]);
   for j:=0 to surf.Vertices.Count-1 do
   begin
    vx:=surf.Vertices[j];
    Loc(vx,lx,ly,lz);
    if (kind=sp_Spherical) or (kind=sp_Dome) or (kind=sp_Conformal) then d:=sqrt(sqr(lx-cx)+sqr(ly-cy)+sqr(lz-cz))
    else d:=sqrt(sqr(lx-cx)+sqr(ly-cy));
    r:=r+d; inc(cnt);
   end;
  end;
  if cnt>0 then r:=r/cnt;
  if r<0.001 then r:=1;

  // 3DO: where the cut around the axis falls, and an optional exact one-texture-width wrap
  seamShift:=0;
  fitDens:=0;
  if (dens3DO>0) and ((kind=sp_Cylindrical) or (kind=sp_Spherical) or (kind=sp_Conformal)) then
  begin
   if SurfSeamFromCam then
   begin
    LocXYZ(SurfCamX,SurfCamY,SurfCamZ,cax,cay,caz);
    seamA:=ArcTan2(cay-cy,cax-cx)+pi;     // far side of the camera
   end
   else seamA:=SurfSeamDeg*pi/180;
   // snap the cut to the azimuth of the nearest vertex so it runs along surface edges, not through a surface
   bestD:=1e30;
   for i:=0 to l.Count-1 do
    for j:=0 to TJKSurface(l[i]).Vertices.Count-1 do
    begin
     Loc(TJKSurface(l[i]).Vertices[j],lx,ly,lz);
     if sqrt(sqr(lx-cx)+sqr(ly-cy))<=0.00001*r then continue;
     dA:=ArcTan2(ly-cy,lx-cx)-seamA;
     while dA>pi do dA:=dA-2*pi;
     while dA<-pi do dA:=dA+2*pi;
     if abs(dA)<bestD then begin bestD:=abs(dA); camA:=ArcTan2(ly-cy,lx-cx); end;
    end;
   if bestD<1e29 then seamA:=camA;
   seamShift:=seamA-pi;                   // the vertex at the seam azimuth lands on +-180 degrees
   if SurfFitWidth then
   begin
    texW:=TextureWidthOf(TJKSurface(l[0]).Material);
    if texW>0 then fitDens:=texW/(2*pi*r);   // pixels per world unit so the circumference is one texture width
   end;
  end;

  case kind of
   sp_Planar: StartUndoRec('Planar texture mapping');
   sp_Box: StartUndoRec('Box texture mapping');
   sp_Cylindrical: StartUndoRec('Cylindrical texture mapping');
   sp_Spherical: StartUndoRec('Spherical texture mapping');
   sp_Dome: StartUndoRec('Dome texture mapping');
   sp_Conformal: StartUndoRec('Spherical (no fins) texture mapping');
  else exit;
  end;

  csurf:=Level.Sectors[Cur_SC].Surfaces[Cur_SF];
  if kind=sp_Planar then BasisFor(VisibleNormal(csurf),un,vn);
  // On level geometry the texture is laid out upright, anchored on vertex 0 of the current surface (which keeps its
  // UV): U runs to the right and V runs down, as seen through the 3D preview camera when it is available, otherwise
  // as seen from the front of the surface with world Z (or map north on floors and ceilings) as up. The scale
  // keeps its size but loses any negative sign, so nothing comes out mirrored.
  levelPlanar:=false;
  if (kind=sp_Planar) and not Is3DOSurf(csurf) then
  begin
   nrm:=csurf.normal;
   if Normalize(nrm) then
   begin
    if SurfHasCamView then
    begin
     // camera right / up projected into the surface plane
     d:=SurfCamRX*nrm.dx+SurfCamRY*nrm.dy+SurfCamRZ*nrm.dz;
     SetVec(nun,SurfCamRX-d*nrm.dx,SurfCamRY-d*nrm.dy,SurfCamRZ-d*nrm.dz);
     d:=SurfCamUX*nrm.dx+SurfCamUY*nrm.dy+SurfCamUZ*nrm.dz;
     SetVec(nvn,-(SurfCamUX-d*nrm.dx),-(SurfCamUY-d*nrm.dy),-(SurfCamUZ-d*nrm.dz));
     levelPlanar:=Normalize(nun) and Normalize(nvn);
     if levelPlanar then
     begin
      // keep V square to U so an oblique view does not shear the texture
      d:=nvn.dx*nun.dx+nvn.dy*nun.dy+nvn.dz*nun.dz;
      SetVec(nvn,nvn.dx-d*nun.dx,nvn.dy-d*nun.dy,nvn.dz-d*nun.dz);
      levelPlanar:=Normalize(nvn);
     end;
    end;
    if not levelPlanar then
    begin
     if abs(nrm.dz)>0.995 then SetVec(ax,0,1,0) else SetVec(ax,0,0,1);
     d:=ax.dx*nrm.dx+ax.dy*nrm.dy+ax.dz*nrm.dz;
     SetVec(nvn,ax.dx-d*nrm.dx,ax.dy-d*nrm.dy,ax.dz-d*nrm.dz);
     if Normalize(nvn) then
     begin
      // right = (-normal) x up, and V runs down
      nun:=VCross(nrm,nvn);
      SetVec(nun,-nun.dx,-nun.dy,-nun.dz);
      SetVec(nvn,-nvn.dx,-nvn.dy,-nvn.dz);
      levelPlanar:=Normalize(nun);
     end;
    end;
   end;
  end;

  for i:=0 to l.Count-1 do
  begin
   surf:=TJKSurface(l[i]);
   SaveSecUndo(surf.sector,ch_changed,sc_geo);

   if Is3DOSurf(surf) and (dens3DO>0) and (ppu>0) then
   begin
    // consistent, sane scale: the projections below multiply by ppu*uscale (pixels per world unit)
    if fitDens>0 then
    begin
     surf.uscale:=fitDens/ppu;
     surf.vscale:=fitDens/ppu;
    end else
    begin
     surf.uscale:=dens3DO/ppu;
     surf.vscale:=dens3DO/ppu;
    end;
   end;

   case kind of
    sp_Planar:
     begin
      // one shared plane, so the texture runs on across all the surfaces
      vx:=csurf.Vertices[0];
      if levelPlanar and not Is3DOSurf(surf) then
      begin
       tx0:=csurf.TXVertices[0];
       // a surface that came from a 3DO model carries meaningless scales (something like 12.2 and -4.3): keep the
       // size only when U and V agree, otherwise start from the normal scale of 1. Never negative, so no mirroring.
       d:=Abs(csurf.uscale);
       r:=Abs(csurf.vscale);
       if (d<0.0001) or (r<0.0001) or (Abs(d-r)>0.01*(d+r)) then
       begin
        d:=1; r:=1;
       end;
       surf.uscale:=d;
       surf.vscale:=r;
       // ArrangeTextureBy reverses V on surfaces that have the flip flag; undo that so V really runs down
       if (surf.SurfFlags and SFF_Flip)<>0 then SetVec(nrm,-nvn.dx,-nvn.dy,-nvn.dz)
       else SetVec(nrm,nvn.dx,nvn.dy,nvn.dz);
       ArrangeTextureBy(surf,nun,nrm,vx.x,vx.y,vx.z,tx0.u,tx0.v);
      end else
      begin
      // the plane comes from the current surface, which may face the other way (or be a 3DO face): make sure the
      // texture still reads the right way round on this surface, otherwise it comes out mirrored
      nrm:=VCross(un,vn);
      ax:=VisibleNormal(surf);
      if nrm.dx*ax.dx+nrm.dy*ax.dy+nrm.dz*ax.dz>0 then
      begin
       SetVec(nrm,-un.dx,-un.dy,-un.dz);
       ArrangeTextureBy(surf,nrm,vn,vx.x,vx.y,vx.z,0,0);
      end else
       ArrangeTextureBy(surf,un,vn,vx.x,vx.y,vx.z,0,0);
      end;
     end;
    sp_Box:
     begin
      AxisNormal(VisibleNormal(surf),ax);
      BasisFor(ax,un,vn);
      ArrangeTextureBy(surf,un,vn,0,0,0,0,0);
     end;
    sp_Dome:
     // top-down (azimuthal) projection about the dome's top: the distance from the centre of the texture is the
     // arc length from the top, so the texture is spread evenly with no pinching and no seam
     begin
      usgn:=OutsideSign(surf,true);
      for j:=0 to surf.Vertices.Count-1 do
      begin
       vx:=surf.Vertices[j];
       d:=sqrt(sqr(vx.x-cx)+sqr(vx.y-cy)+sqr(vx.z-cz));
       if d>0.000001 then t:=(vx.z-cz)/d else t:=1;
       if t>1 then t:=1;
       if t<-1 then t:=-1;
       lat:=ArcCos(t)*r;   // arc length from the top
       ang:=ArcTan2(vx.y-cy,vx.x-cx);
       // seen from inside the dome, looking up: u to the right = -x, v down = -y
       pu:=-usgn*lat*cos(ang)*ppu*surf.uscale;
       pv:=-lat*sin(ang)*ppu*surf.vscale;
       With surf.TXVertices[j] do
       begin
        u:=pu;
        v:=pv;
       end;
      end;
     end;
    sp_Cylindrical, sp_Spherical, sp_Conformal:
     begin
      // angle of every vertex around the axis; a vertex on the axis (a dome's top point) has no angle,
      // it takes the average angle of the surface's other vertices
      usgn:=OutsideSign(surf,kind<>sp_Cylindrical);
      SetLength(angs,surf.Vertices.Count);
      SetLength(okang,surf.Vertices.Count);
      SetLength(rawang,surf.Vertices.Count);
      a0:=0; nok:=0; sa:=0; sumS:=0; sumC:=0;
      for j:=0 to surf.Vertices.Count-1 do
      begin
       vx:=surf.Vertices[j];
       Loc(vx,lx,ly,lz);
       okang[j]:=sqrt(sqr(lx-cx)+sqr(ly-cy))>0.00001*r;
       if not okang[j] then continue;
       ang:=ArcTan2(ly-cy,lx-cx)-seamShift;
       while ang>pi do ang:=ang-2*pi;
       while ang<-pi do ang:=ang+2*pi;
       rawang[j]:=ang;
       sumS:=sumS+sin(ang); sumC:=sumC+cos(ang);
       if nok=0 then a0:=ang;
       inc(nok);
      end;
      // 3DO: unwrap around the surface's mean direction, so a vertex sitting exactly on the cut goes to the
      // side the rest of the surface is on (levels keep the old first-vertex behaviour)
      if (nok>0) and Is3DOSurf(surf) then a0:=ArcTan2(sumS,sumC);
      for j:=0 to surf.Vertices.Count-1 do
       if okang[j] then
       begin
        angs[j]:=Unwrap(rawang[j],a0);
        sa:=sa+angs[j];
       end;
      if nok>0 then sa:=sa/nok else sa:=0;
      for j:=0 to surf.Vertices.Count-1 do
       if not okang[j] then angs[j]:=sa;

      for j:=0 to surf.Vertices.Count-1 do
      begin
       vx:=surf.Vertices[j];
       Loc(vx,lx,ly,lz);
       ang:=angs[j];
       if kind=sp_Cylindrical then
       begin
        pu:=-usgn*ang*r*ppu*surf.uscale;
        pv:=-(lz-cz)*ppu*surf.vscale;
       end else
       begin
        d:=sqrt(sqr(lx-cx)+sqr(ly-cy)+sqr(lz-cz));
        if d>0.000001 then t:=(lz-cz)/d else t:=0;
        if t>1 then t:=1;
        if t<-1 then t:=-1;
        lat:=ArcSin(t);
        if kind=sp_Conformal then
        begin
         // Mercator style: v is stretched as much as u shrinks towards the top, so texture details keep their
         // shape (no radial 'fins'); the latitude is limited to 85 degrees so the top point doesn't go infinite
         if lat>1.4835 then lat:=1.4835;
         if lat<-1.4835 then lat:=-1.4835;
         lat:=Ln(Tan(pi/4+lat/2));
        end;
        pu:=-usgn*ang*r*ppu*surf.uscale;
        pv:=-lat*r*ppu*surf.vscale;
       end;
       With surf.TXVertices[j] do
       begin
        u:=pu;
        v:=pv;
       end;
      end;
     end;
   end;
   SectorChanged(surf.sector);
  end;
  // the UV editor keeps a view aligned to the old UVs: re-align it to the new mapping
  if (UVEdit<>nil) and UVEdit.Visible then UVEdit.ReloadSurface;
 finally
  l.Free;
 end;
end;

// Splits every selected surface into nu x nv smaller surfaces (columns x rows) with the existing cleave code,
// so adjoins, texture mapping and neighbouring surfaces are handled the same way as a manual cleave.
Procedure TJedMain.SurfSubdivide(nu,nv:integer);
type
 TCutPlane=record nx,ny,nz,px,py,pz:double; end;
 TSurfPlan=record sf:TJKSurface; cuts:array of TCutPlane; end;
var
 sels,pieces,snap,allpieces:TList;
 plans:array of TSurfPlan;
 i,j,k,n,c0,q,ci,sc,sfi:integer;
 surf,pc:TJKSurface;
 sec:TJKSector;
 vx:TJKVertex;
 qx,qy,qz,ox,oy,oz:array[0..3] of double;
 dax,day,daz,dbx,dby,dbz,ha,hb,t:double;
 un,vn,v0:TVector;
 mn,mx,d:double;
 cp:TCutPlane;
 skipped:integer;

 // a cut also puts an extra vertex into every neighbouring surface that shares a cut edge (and into
 // their adjoins), so refuse it when one of those would end up with more than 24 vertices
 Function CutIsSafe(pc:TJKSurface;const cpl:TCutPlane):boolean;
 var jj,mm,nn,pass,si,ee,e2:integer;
     sd:array of double;
     dd:double;
     sec2:TJKSector;
     s2:TJKSurface;
     a1,a2,b1,b2:TJKVertex;
     hit:boolean;
 begin
  Result:=true;
  nn:=pc.Vertices.Count;
  SetLength(sd,nn);
  dd:=cpl.nx*cpl.px+cpl.ny*cpl.py+cpl.nz*cpl.pz;
  for jj:=0 to nn-1 do
  begin
   a1:=pc.Vertices[jj];
   sd[jj]:=cpl.nx*a1.x+cpl.ny*a1.y+cpl.nz*a1.z-dd;
  end;
  for jj:=0 to nn-1 do
  begin
   mm:=(jj+1) mod nn;
   if not (((sd[jj]>1e-5) and (sd[mm]<-1e-5)) or ((sd[jj]<-1e-5) and (sd[mm]>1e-5))) then continue;
   a1:=pc.Vertices[jj];
   a2:=pc.Vertices[mm];
   for pass:=0 to 1 do
   begin
    if pass=0 then sec2:=pc.sector
    else if pc.Adjoin<>nil then sec2:=pc.Adjoin.sector
    else break;
    for si:=0 to sec2.Surfaces.Count-1 do
    begin
     s2:=sec2.Surfaces[si];
     if (s2=pc) or (s2=pc.Adjoin) then continue;
     hit:=(s2.Vertices.Count>=24) or ((s2.Adjoin<>nil) and (s2.Adjoin.Vertices.Count>=24));
     if not hit then continue;
     e2:=s2.Vertices.Count;
     for ee:=0 to e2-1 do
     begin
      b1:=s2.Vertices[ee];
      b2:=s2.Vertices[(ee+1) mod e2];
      if ((Abs(b1.x-a1.x)<1e-5) and (Abs(b1.y-a1.y)<1e-5) and (Abs(b1.z-a1.z)<1e-5) and
          (Abs(b2.x-a2.x)<1e-5) and (Abs(b2.y-a2.y)<1e-5) and (Abs(b2.z-a2.z)<1e-5)) or
         ((Abs(b1.x-a2.x)<1e-5) and (Abs(b1.y-a2.y)<1e-5) and (Abs(b1.z-a2.z)<1e-5) and
          (Abs(b2.x-a1.x)<1e-5) and (Abs(b2.y-a1.y)<1e-5) and (Abs(b2.z-a1.z)<1e-5)) then
      begin
       Result:=false;
       exit;
      end;
     end;
    end;
   end;
  end;
 end;

 Procedure AddCut(var pl:TSurfPlan;ax,ay,az,bx,by,bz:double;const nrm:TVector);
 var ex,ey,ez,px,py,pz,l:double;
     m:integer;
 begin
  ex:=bx-ax; ey:=by-ay; ez:=bz-az;
  px:=nrm.dy*ez-nrm.dz*ey;
  py:=nrm.dz*ex-nrm.dx*ez;
  pz:=nrm.dx*ey-nrm.dy*ex;
  l:=Sqrt(px*px+py*py+pz*pz);
  if l<1e-9 then exit;
  m:=Length(pl.cuts);
  SetLength(pl.cuts,m+1);
  pl.cuts[m].nx:=px/l; pl.cuts[m].ny:=py/l; pl.cuts[m].nz:=pz/l;
  pl.cuts[m].px:=ax; pl.cuts[m].py:=ay; pl.cuts[m].pz:=az;
 end;

 Procedure AddPlaneCut(var pl:TSurfPlan;const nrm:TVector;dist:double);
 var m:integer;
 begin
  m:=Length(pl.cuts);
  SetLength(pl.cuts,m+1);
  pl.cuts[m].nx:=nrm.dx; pl.cuts[m].ny:=nrm.dy; pl.cuts[m].nz:=nrm.dz;
  pl.cuts[m].px:=nrm.dx*dist; pl.cuts[m].py:=nrm.dy*dist; pl.cuts[m].pz:=nrm.dz*dist;
 end;

begin
 if nu<1 then nu:=1;
 if nv<1 then nv:=1;
 if nu>16 then nu:=16;
 if nv>16 then nv:=16;
 if (nu=1) and (nv=1) then exit;

 skipped:=0;
 sels:=TList.Create;
 pieces:=TList.Create;
 snap:=TList.Create;
 allpieces:=TList.Create;
 try
  GetSelSurfaces(sels);
  if sels.Count=0 then exit;

  // work out all cut planes first, while every surface still has its original corners
  SetLength(plans,sels.Count);
  for i:=0 to sels.Count-1 do
  begin
   surf:=TJKSurface(sels[i]);
   plans[i].sf:=surf;
   SetLength(plans[i].cuts,0);
   n:=surf.Vertices.Count;
   if n<3 then continue;
   if n=4 then
   begin
    for j:=0 to 3 do
    begin
     vx:=surf.Vertices[j];
     qx[j]:=vx.x; qy[j]:=vx.y; qz[j]:=vx.z;
    end;
    // columns run along the more horizontal pair of edges
    dax:=(qx[1]-qx[0])+(qx[2]-qx[3]); day:=(qy[1]-qy[0])+(qy[2]-qy[3]); daz:=(qz[1]-qz[0])+(qz[2]-qz[3]);
    dbx:=(qx[2]-qx[1])+(qx[3]-qx[0]); dby:=(qy[2]-qy[1])+(qy[3]-qy[0]); dbz:=(qz[2]-qz[1])+(qz[3]-qz[0]);
    ha:=Sqrt(dax*dax+day*day)/(Sqrt(dax*dax+day*day+daz*daz)+1e-12);
    hb:=Sqrt(dbx*dbx+dby*dby)/(Sqrt(dbx*dbx+dby*dby+dbz*dbz)+1e-12);
    if hb>ha+0.05 then
    begin
     for j:=0 to 3 do begin ox[j]:=qx[(j+1) mod 4]; oy[j]:=qy[(j+1) mod 4]; oz[j]:=qz[(j+1) mod 4]; end;
     for j:=0 to 3 do begin qx[j]:=ox[j]; qy[j]:=oy[j]; qz[j]:=oz[j]; end;
    end;
    for k:=1 to nu-1 do
    begin
     t:=k/nu;
     AddCut(plans[i],
       qx[0]+(qx[1]-qx[0])*t, qy[0]+(qy[1]-qy[0])*t, qz[0]+(qz[1]-qz[0])*t,
       qx[3]+(qx[2]-qx[3])*t, qy[3]+(qy[2]-qy[3])*t, qz[3]+(qz[2]-qz[3])*t, surf.normal);
    end;
    for k:=1 to nv-1 do
    begin
     t:=k/nv;
     AddCut(plans[i],
       qx[0]+(qx[3]-qx[0])*t, qy[0]+(qy[3]-qy[0])*t, qz[0]+(qz[3]-qz[0])*t,
       qx[1]+(qx[2]-qx[1])*t, qy[1]+(qy[2]-qy[1])*t, qz[1]+(qz[2]-qz[1])*t, surf.normal);
    end;
   end else
   begin
    // other polygons: regular grid in the surface's own plane
    if abs(surf.normal.dz)>0.7071 then SetVec(v0,0,-1,0) else SetVec(v0,0,0,-1);
    un:=VCross(surf.normal,v0);
    if not Normalize(un) then SetVec(un,1,0,0);
    vn:=VCross(un,surf.normal);
    Normalize(vn);
    mn:=1e30; mx:=-1e30;
    for j:=0 to n-1 do
    begin
     vx:=surf.Vertices[j];
     d:=un.dx*vx.x+un.dy*vx.y+un.dz*vx.z;
     if d<mn then mn:=d;
     if d>mx then mx:=d;
    end;
    for k:=1 to nu-1 do AddPlaneCut(plans[i],un,mn+(mx-mn)*k/nu);
    mn:=1e30; mx:=-1e30;
    for j:=0 to n-1 do
    begin
     vx:=surf.Vertices[j];
     d:=vn.dx*vx.x+vn.dy*vx.y+vn.dz*vx.z;
     if d<mn then mn:=d;
     if d>mx then mx:=d;
    end;
    for k:=1 to nv-1 do AddPlaneCut(plans[i],vn,mn+(mx-mn)*k/nv);
   end;
  end;

  StartUndoRec('Subdivide surface(s)');

  for i:=0 to Length(plans)-1 do
  begin
   pieces.Clear;
   pieces.Add(plans[i].sf);
   for ci:=0 to Length(plans[i].cuts)-1 do
   begin
    cp:=plans[i].cuts[ci];
    snap.Clear;
    for j:=0 to pieces.Count-1 do snap.Add(pieces[j]);
    for j:=0 to snap.Count-1 do
    begin
     pc:=TJKSurface(snap[j]);
     if not CutIsSafe(pc,cp) then begin inc(skipped); continue; end;
     c0:=pc.sector.Surfaces.Count;
     SetVec(un,cp.nx,cp.ny,cp.nz);
     CleaveSurface(pc,un,cp.px,cp.py,cp.pz);
     for q:=c0 to pc.sector.Surfaces.Count-1 do pieces.Add(pc.sector.Surfaces[q]);
    end;
   end;
   for j:=0 to pieces.Count-1 do
    if allpieces.IndexOf(pieces[j])=-1 then allpieces.Add(pieces[j]);
  end;

  // select all the new pieces so a mapping can be applied to them right away
  sfsel.Clear;
  for i:=0 to allpieces.Count-1 do
  begin
   pc:=TJKSurface(allpieces[i]);
   sec:=pc.sector;
   sc:=Level.Sectors.IndexOf(sec);
   sfi:=sec.Surfaces.IndexOf(pc);
   if (sc>=0) and (sfi>=0) then sfsel.AddSF(sc,sfi);
  end;
  if skipped>0 then
   PanMessage(mt_warning,Format('%d cut(s) skipped: a neighbouring surface would exceed 24 vertices.',[skipped]));
  Invalidate;
 finally
  sels.Free;
  pieces.Free;
  snap.Free;
  allpieces.Free;
 end;
end;

Procedure TJedMain.ShiftTexture(how:integer);
var du,dv:double;
    surf:TJKSurface;
    i,sc,sf,n:integer;

procedure ShiftSurf(surf:TJKSurface);
var i:integer;
begin
 SaveSecUndo(surf.sector,ch_changed,sc_geo);

 for i:=0 to surf.TXVertices.count-1 do
 With surf.TXVertices[i] do
 begin
  u:=u+du;
  v:=v+dv;
 end;
 SectorChanged(surf.sector);
end;

begin
 if map_mode<>MM_SF then SetMapMode(MM_SF);
 if not Preview3D.IsActive then exit;
 case how of
  st_left: begin du:=TXStep; dv:=0; end;
  st_right: begin du:=-TXStep; dv:=0; end;
  st_up: begin du:=0; dv:=-TXStep; end;
  st_down: begin du:=0; dv:=TXStep; end;
  else exit;
 end;

 StartUndoRec('Shift texture');

 n:=sfsel.AddSF(Cur_SC,Cur_SF);

 for i:=0 to sfsel.count-1 do
 begin
  sfsel.GetSCSF(i,sc,sf);
  ShiftSurf(Level.Sectors[sc].Surfaces[sf]);
 end;

 sfsel.DeleteN(n);
end;

Procedure TJedMain.RotateTexture(how:integer);
var nu,nv,u,v:tvector;
    surf:TJKSurface;
    du,dv,cosa,sina:double;
    fv:integer;

begin
 if not Preview3D.IsActive then exit;

 fv:=0;
 case map_mode of
  MM_ED: fv:=Cur_ED;
  MM_SF: fv:=0;
  else SetMapMode(MM_SF);
 end;

 case how of
  st_left: begin cosa:=cos(-TXRotStep*pi/180); sina:=sin(-TXRotStep*pi/180); end;
  st_right: begin cosa:=cos(TXRotStep*pi/180); sina:=sin(TXRotStep*pi/180); end;
 end;

 StartUndoRec('Rotate texture');

 surf:=Level.Sectors[cur_SC].Surfaces[Cur_SF];

 SaveSecUndo(surf.sector,ch_changed,sc_geo);


 CalcUVNormals(surf,u,v);

  nv.dx:=-sina*u.dx+cosa*v.dx;
  nv.dy:=-sina*u.dy+cosa*v.dy;
  nv.dz:=-sina*u.dz+cosa*v.dz;

  nu.dx:=cosa*u.dx+sina*v.dx;
  nu.dy:=cosa*u.dy+sina*v.dy;
  nu.dz:=cosa*u.dz+sina*v.dz;

  UpdateSurfUVData(surf,nu,nv);
  ArrangeTexture(surf,fv,nu,nv);
  SectorChanged(surf.sector);
end;

procedure TJedMain.PMsgDblClick(Sender: TObject);
begin
 PMsg.caption:='';
end;

procedure TJedMain.Messages1Click(Sender: TObject);
begin
 MsgForm.Show;
end;

Procedure TJedMain.SectorChanged(s:TJKSector);
begin
 Preview3D.UpdateSector(s);
 LevelChanged;
end;

Procedure TJedMain.SectorAdded(s:TJKSector);
begin
 Preview3D.AddSector(s);
 LevelChanged;
end;

Procedure TJedMain.SectorDeleted(s:TJKSector);
begin
 Preview3D.DeleteSector(s);
 LevelChanged;
end;

Procedure TJedMain.ThingChanged(th:TJKThing);
begin
 UpdateThingData(th);
 Preview3D.UpdateThing(th);
 LevelChanged;
end;

Procedure TJedMain.ThingAdded(th:TJKThing);
begin
 UpdateThingData(th);
 Preview3D.AddThing(th);
 LevelChanged;
end;

Procedure TJedMain.ThingDeleted(th:TJKThing);
begin
 Preview3D.DeleteThing(th);
 LevelChanged;
end;

Procedure TJedMain.RotateObject(angle:double; axis:integer);
var i:integer;
    vec:TVector;
    cx,cy,cz,a:double;
    sec:TJKSector;
    th:TJKThing;
    lt:TJEDLight;
begin

 case axis of
  rt_x: SetVec(vec,1,0,0);
  rt_y: SetVec(vec,0,1,0);
  rt_z: SetVec(vec,0,0,1);
  rt_grid: begin vec:=Renderer.Gnormal; cx:=Renderer.GridX; cy:=Renderer.GridY; cz:=Renderer.GridZ; end;
  else exit;
 end;

 case map_mode of
  MM_SC: begin
          sec:=Level.Sectors[Cur_SC];
          if axis<>rt_grid then CalcSecCenter(sec,cx,cy,cz);
          StartUndoRec('Rotate sector(s)');
          i:=scsel.AddSC(Cur_SC);
          RotateSectors(level,scsel,vec,cx,cy,cz,angle);
          scsel.DeleteN(i);
         end;
  MM_TH: begin
          th:=Level.Things[Cur_TH];
          if axis<>rt_grid then begin cx:=th.x; cy:=th.y; cz:=th.z; end;

          StartUndoRec('Rotate thing(s)');
          i:=thsel.AddTH(Cur_TH);
          RotateThings(level,thsel,vec,cx,cy,cz,angle);
          thsel.DeleteN(i);
         end;
  MM_LT: begin
          lt:=Level.Lights[Cur_LT];
          if axis<>rt_grid then begin cx:=lt.x; cy:=lt.y; cz:=lt.z; end;

          StartUndoRec('Rotate light(s)');
          i:=ltsel.AddLT(Cur_LT);
          RotateLights(level,ltsel,vec,cx,cy,cz,angle);
          ltsel.DeleteN(i);
         end;
  MM_FR: begin
          if axis<>rt_grid then
          begin
           if Cur_FR<0 then with Level.Things[Cur_TH] do begin cx:=x; cy:=y; cz:=z; end
           else Level.Things[Cur_TH].Vals[Cur_FR].GetFrame(cx,cy,cz,a,a,a);
          end;

          StartUndoRec('Rotate frame(s)');
          i:=frsel.AddFR(Cur_TH,Cur_FR);
          RotateFrames(level,frsel,vec,cx,cy,cz,angle);
          frsel.DeleteN(i);
         end;
 end;
Invalidate;
end;

Procedure TJedMain.FlipObject(how:integer);
var cx,cy,cz,a:double;
    i:integer;
    vec:TVector;
begin
 case map_mode of
  MM_SC: begin
          StartUndorec('Flip sector(s)');
          i:=scsel.AddSC(Cur_SC);
          if how=rt_grid then FlipSectorsOverPlane(level,scsel,Renderer.gnormal,Renderer.GridX,Renderer.Gridy,Renderer.GridZ)
          else
          begin
           CalcSecCenter(level.sectors[Cur_SC],cx,cy,cz);
           StartUndoRec('Flip Sectors');
           FlipSectors(level,scsel,cx,cy,cz,how);
          end;
          scsel.DeleteN(i);
         end;
  MM_TH: begin
          StartUndorec('Flip thing(s)');
          {SaveSelThingsUndo('Change thing(s)',ch_changed);}
          i:=thsel.AddTH(Cur_TH);

          if how=rt_grid then FlipThingsOverPlane(level,thsel,Renderer.gnormal,Renderer.GridX,Renderer.Gridy,Renderer.GridZ)
          else With Level.Things[Cur_TH] do FlipThings(level,thsel,x,y,z,how);
          thsel.DeleteN(i);
         end;
  MM_LT: begin
          StartUndorec('Flip light(s)');
          {SaveSelThingsUndo('Change thing(s)',ch_changed);}
          i:=ltsel.AddLT(Cur_LT);

          With Level.lights[Cur_LT] do
          begin
           cx:=x; cy:=y; cz:=z;
          end;

          case how of
           rt_x: SetVec(vec,1,0,0);
           rt_y: SetVec(vec,0,1,0);
           rt_z: SetVec(vec,0,0,1);
           rt_grid: begin
                     vec:=Renderer.gnormal;
                     cx:=Renderer.GridX;
                     cy:=Renderer.GridY;
                     cz:=Renderer.GridZ;
                    end;
          end;
          FlipLightsOverPlane(level,ltsel,vec,cx,cy,cz);
          ltsel.DeleteN(i);
         end;
  MM_FR: begin
          StartUndorec('Flip frame(s)');
          {SaveSelThingsUndo('Change thing(s)',ch_changed);}
          i:=frsel.AddFR(Cur_TH,Cur_FR);

          if Cur_FR<0 then With Level.Things[Cur_TH] do
          begin
           cx:=x; cy:=y; cz:=z;
          end else Level.Things[Cur_TH].Vals[Cur_FR].GetFrame(cx,cy,cz,a,a,a);

          case how of
           rt_x: SetVec(vec,1,0,0);
           rt_y: SetVec(vec,0,1,0);
           rt_z: SetVec(vec,0,0,1);
           rt_grid: begin
                     vec:=Renderer.gnormal;
                     cx:=Renderer.GridX;
                     cy:=Renderer.GridY;
                     cz:=Renderer.GridZ;
                    end;
          end;
          FlipFramesOverPlane(level,frsel,vec,cx,cy,cz);
          frsel.DeleteN(i);
         end;
 end;
Invalidate;
end;


Procedure TJedMain.ScaleObject(sfactor:double;how:integer);
var sd:TScaleData;
    a:double;
    i:integer;
begin
 sd.sfactor:=sfactor;
 if (how and sc_ScaleX<>0) then sd.how:=scale_x else
 if (how and sc_ScaleY<>0) then sd.how:=scale_y else
 if (how and sc_ScaleZ<>0) then sd.how:=scale_z else
 if (how and sc_ScaleGrid<>0) then
 begin
  sd.how:=scale_vec;
  sd.vec:=Renderer.GNormal;
 end
 else sd.how:=scale_XYZ;

 case map_mode of
  MM_SC: begin
          StartUndoRec('Scale sector(s)');
          CalcSecCenter(Level.Sectors[Cur_SC],sd.cx,sd.cy,sd.cz);
          i:=scsel.AddSC(cur_SC);
          ScaleSectors(level,scsel,sd,how and sc_ScaleTX<>0);
          scsel.DeleteN(i);
         end;
  MM_TH: begin
          StartUndoRec('Scale thing(s)');
          i:=thsel.AddTH(Cur_TH);
          With Level.Things[Cur_TH] do
          begin
           sd.cx:=x; sd.cy:=y; sd.cz:=z;
          end;
          ScaleThings(level,thsel,sd);
          thsel.DeleteN(i);
         end;
  MM_LT: begin
          StartUndoRec('Scale light(s)');
          i:=ltsel.AddLT(Cur_LT);
          With Level.Lights[Cur_LT] do
          begin
           sd.cx:=x; sd.cy:=y; sd.cz:=z;
          end;
          ScaleLights(level,ltsel,sd);
          ltsel.DeleteN(i);
         end;
  MM_FR: begin
          StartUndoRec('Scale light(s)');
          i:=frsel.AddFR(Cur_TH,Cur_FR);
          if Cur_FR=-1 then With Level.Things[Cur_TH] do begin sd.cx:=x; sd.cy:=y; sd.cz:=z; end
          else Level.Things[Cur_TH].Vals[Cur_FR].GetFrame(sd.cx,sd.cy,sd.cz,a,a,a);
          ScaleFrames(level,frsel,sd);
          frsel.DeleteN(i);
         end;

 end;
Invalidate;
end;

Procedure TJedMain.TranslateObject(dx,dy,dz:double);
var sec:TJKSector;
    surf:TJKSurface;
    i:integer;
begin
case Map_Mode of
 MM_SC: begin
         StartUndorec('Translate sectors');
         sec:=Level.Sectors[Cur_SC];
         TranslateSectors(level,scsel,Cur_SC,dx,dy,dz);
        end;
 MM_SF: begin
         StartUndorec('Translate surfaces');
         surf:=Level.Sectors[Cur_SC].Surfaces[Cur_SF];
         TranslateSurfaces(Level,sfsel,Cur_SC,Cur_SF,dx,dy,dz);
        end;
end;
Invalidate;
end;

Procedure TJedMain.StartStitch;
begin
if map_mode<>MM_SF then exit;
 stitch_Sec:=Level.Sectors[Cur_SC];
 stitch_Surf:=Level.Sectors[Cur_SC].Surfaces[Cur_SF];
end;

Procedure TJedMain.DoStitch;
var ssurf,esurf:TJKSurface;
begin
if map_mode<>MM_SF then exit;
if stitch_sec=nil then
begin
 PanMessage(mt_error,'No start surface was set for stitching');
 exit;
end;

if (Level.Sectors.IndexOf(stitch_sec)<0) or
 (stitch_sec.Surfaces.IndexOf(stitch_surf)<0) then
 begin
  PanMessage(mt_error,'The stitching start surface was deleted');
  exit;
 end;

 ssurf:=stitch_surf; esurf:=Level.Sectors[Cur_SC].Surfaces[Cur_SF];


 StartUndoRec('Stitch surfaces');
 StitchSurfaces(ssurf,esurf);
 if ssurf.Material<>'' then esurf.Material:=ssurf.Material;
 //NJED
 if ssurf.Material<>'' then esurf.SurfFlags:=ssurf.SurfFlags;
 if ssurf.Material<>'' then esurf.FaceFlags:=ssurf.FaceFlags;


 SectorChanged(esurf.sector);
 StartStitch;
end;

Procedure TJedMain.StraightenTexture(zero,rot90:boolean);
var u,v:tvector;
    surf:TJKSurface;


Procedure StrEd(surf:TJKSurface;ed:integer);
begin
 SaveSecUndo(surf.sector,ch_changed,sc_geo);

  if rot90 then
  begin
   CalcDefaultUVNormals(surf,ED,v,u);
   v.dx:=-v.dx;
   v.dy:=-v.dy;
   v.dz:=-v.dz;
   UpdateSurfUVData(surf,u,v);
  end else CalcDefaultUVNormals(surf,ED,u,v);

  if zero then with surf.TXvertices[ED] do
  begin
   u:=0;
   v:=0;
  end;
  ArrangeTexture(surf,ED,u,v);
  SectorChanged(surf.sector);
end;

Procedure StrSurf(surf:TJKSurface);
begin
 SaveSecUndo(surf.sector,ch_changed,sc_geo);

 if rot90 then
 begin
  CalcUVNormals(surf,v,u);
  v.dx:=-v.dx;
  v.dy:=-v.dy;
  v.dz:=-v.dz;
  UpdateSurfUVData(surf,u,v);
 end else CalcUVNormals(surf,u,v);
 if zero then
 With surf.txvertices[0] do begin u:=0; v:=0; end;
 ArrangeTexture(surf,0,u,v);
 SectorChanged(surf.sector);
end;

Var
    i,sc,sf,ed,n:integer;

begin
 case map_mode of
  MM_SF: begin
          StartUndoRec('Straighten surfaces');
          n:=sfsel.AddSF(Cur_SC,Cur_SF);
          for i:=0 to sfsel.count-1 do
          begin
           sfsel.GetSCSF(i,sc,sf);
           strSurf(Level.Sectors[sc].Surfaces[SF]);
          end;
          sfsel.DeleteN(n);
         end;
  MM_ED: begin
          StartUndoRec('Straighten surfaces');
          n:=edsel.AddED(Cur_SC,Cur_SF,Cur_ED);
          for i:=0 to edsel.count-1 do
          begin
           edsel.GetSCSFED(i,sc,sf,ed);
           strEd(Level.Sectors[sc].Surfaces[SF],ed);
          end;
          edsel.DeleteN(n);
        end;
  end;
end;

Procedure TJedMain.GetCam(var X,Y,Z,PCH,YAW,ROL:Double);
begin
 x:=-Renderer.CamX;
 y:=-Renderer.Camy;
 z:=-Renderer.CamZ;
 if maprot<>MR_OLD then GETPYR;
 pch:=rPCH;
 yaw:=rYAW;
 rol:=rROL;
end;

Procedure TJedMain.SetCam(X,Y,Z,PCH,YAW,ROL:Double);
var zv,xv:TVector;
begin
 Renderer.CamX:=-x;
 Renderer.CamY:=-Y;
 Renderer.CamZ:=-Z;

{ SetVec(xv,1,0,0);
 SetVec(zv,0,0,1);
 RotateVector(xv,pch,yaw,rol);
 RotateVector(zv,pch,yaw,rol);

 Renderer.SetZ(zv.dx,zv.dy,zv.dz);
 Renderer.SetX(xv.dx,xv.dy,xv.dz);}

 rPch:=PCH;
 rYaw:=Yaw;
 rRol:=Rol;
 SetRendFromPYR;

 Invalidate;
end;

Procedure TJedMain.RaiseObject(how:integer);
var dx,dy,dz:double;
    th:TJKThing;
    vl:TTPLValue;
begin

 With Renderer do
 if how=ro_up then begin dx:=gnormal.dx*perpStep; dy:=gnormal.dy*perpStep; dz:=gnormal.dz*perpStep; end
 else begin dx:=-gnormal.dx*perpStep; dy:=-gnormal.dy*perpStep; dz:=-gnormal.dz*perpStep; end;

 case Map_mode of
  MM_SC: begin
          StartUndoRec('Translate Sector(s)');
          TranslateSectors(level,scsel,Cur_SC,dx,dy,dz);
         end;
  MM_SF: begin
          StartUndoRec('Translate surface(s)');
          TranslateSurfaces(Level,sfsel,Cur_SC,Cur_SF,dx,dy,dz);
         end;
    {TranslateSurface(Level.Sectors[Cur_SC].Surfaces[Cur_SF],
           dx,dy,dz);}
  MM_VX: begin
          StartUndoRec('Translate vertices');
          TranslateVertices(level,vxsel,cur_SC,Cur_VX,dx,dy,dz);
         end;

  MM_ED: begin
          StartUndoRec('Translate Edge(s)');
          TranslateEdges(level,edsel,Cur_SC,Cur_SF,Cur_ED,dx,dy,dz);
         end;
  MM_TH: begin
          StartUndoRec('Translate thing(s)');
          {SaveSelThingsUndo('Translate thing(s)',ch_changed);}
          TranslateThings(level,thsel,Cur_TH,dx,dy,dz,MoveFrames);
         end;
  MM_FR: begin
          StartUndoRec('Translate frame(s)');
          {SaveSelFramesUndo('Translate frame(s)',ch_changed);}
          if Cur_FR=-1 then TranslateThingKeepFrame(Level,Cur_TH,dx,dy,dz)
          else TranslateFrames(level,frsel,Cur_TH,Cur_FR,dy,dy,dz);
         end;
  MM_LT: begin
          {SaveSelLightsUndo('Translate thing(s)',ch_changed);}
          StartUndoRec('Translate light(s)');
          TranslateLights(level,ltsel,Cur_LT,dx,dy,dz);
         end;
  else exit;
 end;
 Invalidate;
end;

Function IsSCValid(sc:integer):boolean;
begin
 result:=(SC>=0) and (SC<Level.Sectors.count);
end;

Function IsSFValid(sc,sf:integer):boolean;
begin
 result:=false;
 if (SC<0) or (SC>=Level.Sectors.count) then exit;
 Result:=(SF>=0) and (SF<Level.Sectors[SC].Surfaces.count);
end;

Function IsEDValid(sc,sf,ed:integer):boolean;
begin
 result:=false;
 if (SC<0) or (SC>=Level.Sectors.count) then exit;
 if (SF<0) or (SF>=Level.Sectors[SC].Surfaces.count) then exit;
 Result:=(ED>=0) and (ED<Level.Sectors[SC].Surfaces[SF].Vertices.count);
end;

Function IsVXValid(sc,vx:integer):boolean;
begin
 result:=false;
 if (SC<0) or (SC>=Level.Sectors.count) then exit;
 Result:=(VX>=0) and (VX<Level.Sectors[SC].Vertices.count);
end;

Function IsTHValid(th:integer):boolean;
begin
 result:=(TH>=0) and (TH<Level.Things.count);
end;

Function IsLTValid(lt:integer):boolean;
begin
 result:=(LT>=0) and (LT<Level.Lights.count);
end;

Function IsFRValid(th,fr:integer):boolean;
begin
 result:=false;
 if (TH<0) or (TH>=Level.Things.count) then exit;
 Result:=(FR>=-1) and (FR<Level.Things[TH].Vals.count);
end;

Procedure TJedMain.VerifyMultiSelection;
var i,sc,sf,ed,vx,fr,n:integer;
begin
 case map_mode of
  MM_SC: For i:=scsel.count-1 downto 0 do
         if not IsSCValid(scsel.getSC(i)) then scsel.DeleteN(i);
  MM_SF: For i:=sfsel.count-1 downto 0 do
         begin
          sfsel.GetSCSF(i,sc,sf);
          if not IsSFValid(sc,sf) then sfsel.DeleteN(i);
         end;
  MM_ED: For i:=edsel.count-1 downto 0 do
         begin
          edsel.GetSCSFED(i,sc,sf,ed);
          if not IsEDValid(sc,sf,ed) then edsel.DeleteN(i);
         end;
  MM_VX: For i:=vxsel.count-1 downto 0 do
         begin
          vxsel.GetSCVX(i,sc,vx);
          if not IsVXValid(sc,vx) then vxsel.DeleteN(i);
         end;
  MM_TH: For i:=thsel.count-1 downto 0 do
         if not IsTHValid(thsel.getTH(i)) then thsel.DeleteN(i);
  MM_FR: For i:=frsel.count-1 downto 0 do
         begin
          frsel.GetTHFR(i,n,fr);
          if not IsFRValid(n,fr) then frsel.DeleteN(i);
         end;
  MM_LT: For i:=ltsel.count-1 downto 0 do
         if not IsLTValid(ltsel.getLT(i)) then ltsel.DeleteN(i);
 end;
end;

Procedure TJedMain.VerifySelection;
begin
 if not IsSelValid then SetMapMode(map_mode);
end;

Function TJedMain.IsSelValid:boolean;
begin
 case map_mode of
  MM_SC: result:=(Cur_SC>=0) and (Cur_SC<Level.Sectors.count);
  MM_SF: begin
          result:=false;
          if (Cur_SC<0) or (Cur_SC>=Level.Sectors.count) then exit;
          Result:=(Cur_SF>=0) and (Cur_SF<Level.Sectors[Cur_SC].Surfaces.count);
         end;
  MM_ED: begin
          result:=false;
          if (Cur_SC<0) or (Cur_SC>=Level.Sectors.count) then exit;
          if (Cur_SF<0) or (Cur_SF>=Level.Sectors[Cur_SC].Surfaces.count) then exit;
          Result:=(Cur_ED>=0) and (Cur_ED<Level.Sectors[Cur_SC].Surfaces[Cur_SF].Vertices.count);
         end;
  MM_VX: begin
          result:=false;
          if (Cur_SC<0) or (Cur_SC>=Level.Sectors.count) then exit;
          Result:=(Cur_VX>=0) and (Cur_VX<Level.Sectors[Cur_SC].Vertices.count);
         end;
  MM_TH: result:=(Cur_TH>=0) and (Cur_TH<Level.Things.count);
  MM_FR: begin
          result:=false;
          if (Cur_TH<0) or (Cur_TH>=Level.Things.count) then exit;
          Result:=(Cur_FR>=-1) and (Cur_FR<Level.Things[Cur_TH].Vals.count);
         end;
  MM_LT: result:=(Cur_LT>=0) and (Cur_LT<Level.Lights.count);
  MM_Extra: result:=(Cur_EX>=0) and (Cur_EX<ExtraObjs.count);
 else result:=false;
 end;
end;

procedure TJedMain.RecentClick(Sender: TObject);
begin
 if Not AskSave then exit;
 OpenProject((Sender as TMenuItem).hint,op_open);
end;

Procedure TJedMain.SyncRecents;
var sub:TMenuItem;

Procedure AddItem(const s:string);
var mi:TMenuItem;
    dn,fn:string;
begin
 if s='' then exit;
 mi:=TMenuItem.Create(OpenRecentMenu);
 if length(s)>32 then
 begin
  dn:=ExtractPath(s);
  fn:=ExtractName(s);
  dn:=copy(dn,1,28-length(fn));
  mi.caption:=dn+'...'+'\'+fn;
 end
 else mi.Caption:=s;
 mi.hint:=s;
 mi.OnClick:=RecentClick;
 OpenRecentMenu.Add(mi);
end;

begin
 EnsureRecents;
 // Old flat list lived below the RecentBar separator; now it is an "Open Recent" submenu
 RecentBar.Visible:=false;
 if OpenRecentMenu=nil then
 begin
  OpenRecentMenu:=TMenuItem.Create(FileMenu);
  OpenRecentMenu.Caption:='Open &Recent';
  FileMenu.Insert(OpenMenu.MenuIndex+1,OpenRecentMenu);
 end;
 While OpenRecentMenu.Count>0 do OpenRecentMenu.Delete(0);
 AddItem(Recent1);
 AddItem(Recent2);
 AddItem(Recent3);
 AddItem(Recent4);
 OpenRecentMenu.Enabled:=OpenRecentMenu.Count>0;
 SyncImportRecents;
end;

Procedure TJedMain.AddRecent(const s:string);
var sl:TStringList;
    i:integer;
begin
 EnsureRecents;
 sl:=TStringList.Create;
 sl.Add(Recent1);
 sl.Add(Recent2);
 sl.Add(Recent3);
 sl.Add(Recent4);
 i:=sl.IndexOf(s);

 if (i<>-1) then sl.Delete(i);
 sl.Insert(0,s);

 Recent1:=sl[0];
 Recent2:=sl[1];
 Recent3:=sl[2];
 Recent4:=sl[3];

 WriteRecents;

 sl.Free;

 SyncRecents;
end;

Procedure TJedMain.BuildToolStrip;
const Caps:array[0..9] of string=('Select','Move','Cleave','New Sector','Scale','Extrude','Plane Cut','Inset','Box Cut','Bevel');
      Tips:array[0..9] of string=('Select: click to select (click this button again to deselect everything)','Move: drag the gizmo arrows to move the selection (hold Shift to ignore grid snapping)','Cleave sector (C)','Create sector (K)','Scale: drag the gizmo handles to scale the selection','Extrude: drag the arrow to extrude the surface','Plane Cut: move the cleave plane with the arrow, pick its axis, then press Cut now','Inset: drag the orange square on the surface towards its center','Box Cut: drag a rectangle on the selected surface to cut it out (doors, windows). Shift = ignore grid snapping','Bevel: drag the orange square on the surface to chamfer its edges (cuts a slanted face where the surface meets its neighbours)');
const PCaps:array[1..4] of string=('X','Y','Z','G');
var i:integer;
begin
 ToolPanel:=TPanel.Create(Self);
 ToolPanel.Parent:=Self;
 ToolPanel.Left:=4;
 ToolPanel.Top:=Tbar.Height+6;
 ToolPanel.Width:=84;
 ToolPanel.BevelOuter:=bvRaised;
 ToolPanel.Caption:='';

 ToolTitle:=TLabel.Create(Self);
 ToolTitle.Parent:=ToolPanel;
 ToolTitle.Left:=8;
 ToolTitle.Top:=5;
 ToolTitle.Font.Style:=[fsBold];
 ToolTitle.Caption:='Sector';

 for i:=0 to 9 do
 begin
  ToolBtns[i]:=TSpeedButton.Create(Self);
  ToolBtns[i].Parent:=ToolPanel;
  ToolBtns[i].Left:=4;
  ToolBtns[i].Top:=24+i*28;
  ToolBtns[i].Width:=76;
  ToolBtns[i].Height:=26;
  ToolBtns[i].GroupIndex:=7;
  ToolBtns[i].Flat:=true;
  ToolBtns[i].Caption:=Caps[i];
  ToolBtns[i].Hint:=Tips[i];
  ToolBtns[i].ShowHint:=true;
  ToolBtns[i].Tag:=i;
  ToolBtns[i].OnClick:=ToolStripClick;
 end;
 ToolBtns[0].Down:=true;
 ToolWeld:=TCheckBox.Create(Self);
 ToolWeld.Parent:=ToolPanel;
 ToolWeld.Left:=6;
 ToolWeld.Width:=74;
 ToolWeld.Caption:='Weld verts';
 ToolWeld.Hint:='Surface mode: also move vertices of other sectors that touch the moved surface';
 ToolWeld.ShowHint:=true;
 ToolWeld.Checked:=true;
 ToolWeld.Visible:=false;
 PlaneAxis:=3;
 for i:=1 to 4 do
 begin
  PlaneBtns[i]:=TSpeedButton.Create(Self);
  PlaneBtns[i].Parent:=ToolPanel;
  PlaneBtns[i].Left:=4+(i-1)*19;
  PlaneBtns[i].Width:=19;
  PlaneBtns[i].Height:=22;
  PlaneBtns[i].GroupIndex:=8;
  PlaneBtns[i].Flat:=true;
  PlaneBtns[i].Caption:=PCaps[i];
  PlaneBtns[i].Tag:=i;
  PlaneBtns[i].ShowHint:=true;
  PlaneBtns[i].Visible:=false;
  PlaneBtns[i].OnClick:=PlaneAxisClick;
 end;
 PlaneBtns[1].Hint:='Plane perpendicular to the X axis';
 PlaneBtns[2].Hint:='Plane perpendicular to the Y axis';
 PlaneBtns[3].Hint:='Plane perpendicular to the Z axis (horizontal cut)';
 PlaneBtns[4].Hint:='Plane parallel to the grid';
 PlaneBtns[3].Down:=true;
 PlaneRstBtn:=TSpeedButton.Create(Self);
 PlaneRstBtn.Parent:=ToolPanel;
 PlaneRstBtn.Left:=4;
 PlaneRstBtn.Width:=76;
 PlaneRstBtn.Height:=22;
 PlaneRstBtn.Flat:=true;
 PlaneRstBtn.Caption:='Reset tilt';
 PlaneRstBtn.Hint:='Put the plane back to its axis. Drag the orange squares on the plane edge to tilt it (Ctrl = 15 degree steps)';
 PlaneRstBtn.ShowHint:=true;
 PlaneRstBtn.Visible:=false;
 PlaneRstBtn.OnClick:=PlaneResetClick;
 PlaneCutBtn:=TSpeedButton.Create(Self);
 PlaneCutBtn.Parent:=ToolPanel;
 PlaneCutBtn.Left:=4;
 PlaneCutBtn.Width:=76;
 PlaneCutBtn.Height:=26;
 PlaneCutBtn.Flat:=true;
 PlaneCutBtn.Caption:='Cut now';
 PlaneCutBtn.Hint:='Cleave the selection with the plane';
 PlaneCutBtn.ShowHint:=true;
 PlaneCutBtn.Visible:=false;
 PlaneCutBtn.OnClick:=PlaneCutClick;
 ToolPanel.BringToFront;
 UpdateToolStrip;
end;

Procedure TJedMain.UpdateToolStrip;
const BtnOrder:array[0..9] of integer=(0,1,4,5,7,9,8,6,2,3);
var idx,n,k,y:integer;
    sc,sca,pl:boolean;
begin
 if ToolPanel=nil then exit;
 case map_mode of
  MM_SC: ToolTitle.Caption:='Sector';
  MM_SF: ToolTitle.Caption:='Surface';
  MM_VX: ToolTitle.Caption:='Vertex';
  MM_ED: ToolTitle.Caption:='Edge';
  MM_TH: ToolTitle.Caption:='Thing';
  MM_LT: ToolTitle.Caption:='Light';
  MM_FR: ToolTitle.Caption:='Frame';
 else ToolTitle.Caption:='Tools';
 end;
 sc:=map_mode=MM_SC;
 sca:=(map_mode=MM_SC) or (map_mode=MM_SF) or (map_mode=MM_TH) or (map_mode=MM_LT) or (map_mode=MM_FR);
 if ToolScale and not sca then ToolScale:=false;
 if ToolExtrude and (map_mode<>MM_SF) then ToolExtrude:=false;
 if ToolInset and (map_mode<>MM_SF) then ToolInset:=false;
 if ToolBox and (map_mode<>MM_SF) then ToolBox:=false;
 if ToolBevel and (map_mode<>MM_SF) then ToolBevel:=false;
 pl:=(map_mode=MM_SC) or (map_mode=MM_SF) or (map_mode=MM_ED);
 if ToolPlane and not pl then ToolPlane:=false;
 ToolBtns[2].Visible:=false;      {the Cleave button was replaced by Plane Cut (the C key still works)}
 ToolBtns[7].Visible:=map_mode=MM_SF;
 ToolBtns[8].Visible:=map_mode=MM_SF;
 ToolBtns[9].Visible:=map_mode=MM_SF;
 ToolBtns[3].Visible:=sc;
 ToolBtns[4].Visible:=sca;
 ToolBtns[5].Visible:=map_mode=MM_SF;
 ToolBtns[6].Visible:=pl;
 if sc and (mouse_mode=MM_Cleave) then idx:=2
 else if sc and (mouse_mode=MM_CreateSector) then idx:=3
 else if ToolBevel then idx:=9
 else if ToolBox then idx:=8
 else if ToolInset then idx:=7
 else if ToolPlane then idx:=6
 else if ToolExtrude then idx:=5
 else if ToolScale then idx:=4
 else if ToolMove then idx:=1
 else idx:=0;
 if mouse_mode in [MM_Select,MM_Cleave,MM_CreateSector] then ToolBtns[idx].Down:=true;
 n:=0;
 for k:=0 to 9 do
  if ToolBtns[BtnOrder[k]].Visible then
  begin
   ToolBtns[BtnOrder[k]].Top:=24+n*28;
   inc(n);
  end;
 y:=24+n*28+2;
 ToolWeld.Visible:=(map_mode=MM_SF) and ToolMove;
 ToolWeld.Top:=y;
 if ToolWeld.Visible then inc(y,24);
 for k:=1 to 4 do
 begin
  PlaneBtns[k].Visible:=ToolPlane;
  PlaneBtns[k].Top:=y;
 end;
 if ToolPlane then inc(y,26);
 PlaneRstBtn.Visible:=ToolPlane;
 PlaneRstBtn.Top:=y;
 if ToolPlane then inc(y,24);
 PlaneCutBtn.Visible:=ToolPlane;
 PlaneCutBtn.Top:=y;
 if ToolPlane then inc(y,28);
 ToolPanel.Height:=y+2;
end;

procedure TJedMain.ToolStripClick(Sender: TObject);
var wasSelect:boolean;
begin
 wasSelect:=not (ToolMove or ToolScale or ToolExtrude or ToolPlane or ToolInset or ToolBox or ToolBevel) and (mouse_mode=MM_Select);
 ToolInset:=false;
 ToolBox:=false;
 ToolBevel:=false;
 if wasSelect and ((Sender as TSpeedButton).Tag=0) then ClearMultiSelection;
 case (Sender as TSpeedButton).Tag of
  0: begin ToolMove:=false; ToolScale:=false; ToolExtrude:=false; ToolPlane:=false; SetMouseMode(MM_SELECT); end;
  1: begin ToolMove:=true; ToolScale:=false; ToolExtrude:=false; ToolPlane:=false; SetMouseMode(MM_SELECT); end;
  4: begin ToolMove:=false; ToolScale:=true; ToolExtrude:=false; ToolPlane:=false; SetMouseMode(MM_SELECT); end;
  5: begin ToolMove:=false; ToolScale:=false; ToolExtrude:=true; ToolPlane:=false; SetMouseMode(MM_SELECT); end;
  6: begin ToolMove:=false; ToolScale:=false; ToolExtrude:=false; ToolPlane:=true; PlaneKey:=''; SetMouseMode(MM_SELECT); end;
  7: begin ToolMove:=false; ToolScale:=false; ToolExtrude:=false; ToolPlane:=false; ToolInset:=true; SetMouseMode(MM_SELECT); end;
  9: begin
      ToolMove:=false; ToolScale:=false; ToolExtrude:=false; ToolPlane:=false; ToolBevel:=true; SetMouseMode(MM_SELECT);
      PMsg.Caption:='Bevel: select a surface, then drag the orange square (Shift ignores grid snap)';
     end;
  8: begin
      ToolMove:=false; ToolScale:=false; ToolExtrude:=false; ToolPlane:=false; ToolBox:=true; SetMouseMode(MM_SELECT);
      PMsg.Caption:='Box Cut: select a surface, then drag a rectangle on it (Shift ignores grid snap)';
     end;
  2: begin
      SetMouseMode(MM_CLEAVE);
      PMsg.Caption:='Cleave Mode: hold CTRL to force snap to grid, shift to snap to vertex';
     end;
  3: SetMouseMode(MM_CreateSector);
 end;
 Invalidate;
end;

Procedure TJedMain.SyncImportRecents;
var i:integer;
    mi:TMenuItem;
    s,dn,fn:string;
begin
 EnsureImportRecents;
 if ImportRecentMenu=nil then
 begin
  ImportRecentMenu:=TMenuItem.Create(FileMenu);
  ImportRecentMenu.Caption:='Import Recen&t';
  FileMenu.Insert(Import1.MenuIndex+1,ImportRecentMenu);
 end;
 While ImportRecentMenu.Count>0 do ImportRecentMenu.Delete(0);
 for i:=1 to 4 do
 begin
  s:=ImportRecents[i];
  if s='' then continue;
  mi:=TMenuItem.Create(ImportRecentMenu);
  if length(s)>32 then
  begin
   dn:=ExtractPath(s);
   fn:=ExtractName(s);
   dn:=copy(dn,1,28-length(fn));
   mi.caption:=dn+'...'+'\'+fn;
  end
  else mi.Caption:=s;
  mi.hint:=s;
  mi.OnClick:=ImportRecentClick;
  ImportRecentMenu.Add(mi);
 end;
 ImportRecentMenu.Enabled:=ImportRecentMenu.Count>0;
end;

Procedure TJedMain.AddImportRecent(const s:string);
var sl:TStringList;
    i:integer;
begin
 EnsureImportRecents;
 sl:=TStringList.Create;
 try
  for i:=1 to 4 do sl.Add(ImportRecents[i]);
  i:=sl.IndexOf(s);
  if i<>-1 then sl.Delete(i);
  sl.Insert(0,s);
  for i:=1 to 4 do ImportRecents[i]:=sl[i-1];
 finally
  sl.Free;
 end;
 WriteImportRecents;
 SyncImportRecents;
end;

procedure TJedMain.SaveJKLGob1Click(Sender: TObject);
begin
 if DoSaveJKL then GobProject1.Click;
end;

procedure TJedMain.SaveJKLGOBandTest1Click(Sender: TObject);
var gobname,batname,ext:string;
    t:TextFile;
    pdir:array[0..255] of char;
    prjdir,name:string;
    pathL:integer;
    useOJ:boolean;
    sl:TStringList;
begin
 If MsgBox('You''re about to test your level. Proceed?','Warning',mb_YesNo)=idNo then exit;

 if DoSaveJKL then
 begin
   batname:=ProjectDir+'Test_'+ChangeFileExt(ExtractFileName(LevelFile),'.bat');
   useOJ:=FileExists(GameDir+'openjkdf2-64.exe');

   // an old batch file that still starts the original game is rebuilt once OpenJKDF2 is installed
   if useOJ and FileExists(batname) then
   begin
    sl:=TStringList.Create;
    try
     sl.LoadFromFile(batname);
     if Pos('openjkdf2',LowerCase(sl.Text))=0 then DeleteFile(batname);
    finally
     sl.Free;
    end;
   end;

   if not FileExists(batname) then
   begin
    if IsMots then ext:='jkm.exe' else ext:='jk.exe';

    if FileExists(GameDir+'inject.exe') then ext:='inject.exe';

    // OpenJKDF2 takes priority when it is installed in the game directory
    if FileExists(GameDir+'openjkdf2-64.exe') then ext:='openjkdf2-64.exe';

    //if Pos(' ',ProjectDir)=0 then StrLCopy(pdir,Pchar(ProjectDir),sizeof(pdir))
    //else
     //GetShortPathName(pchar(ProjectDir),pdir,sizeof(pdir));
      prjdir:=SysUtils.ExtractShortPathName(ProjectDir);

      name:=ExtractFileName(ExcludeTrailingPathDelimiter(prjdir));
      pathL:= length(name);

      //NJed 10/22/22
      // OpenJKDF2 handles long paths, only the original engine needs 8:3
      if (not useOJ) and ((Pos(' ',prjdir)>0) or (pathL >8)) then
      begin
        If MsgBox('Project path must be in 8:3 format.'+#13
             +'Check if 8:3 filenames are enabled in project direcory with dos cmd dir /x.'+#13
             +'Proceed?','Warning',mb_YesNo)=idNo then exit;
      end;

      
    AssignFile(t,batname); Rewrite(t);
    Writeln(t,ExtractFileDrive(GameDir));
    Writeln(t,'cd "',GameDir,'"');
    if useOJ then
     Writeln(t,ext,' -verbose 2 -windowgui -devmode -dispstats -debug log -displayconfig -path "'+ExcludeTrailingPathDelimiter(ProjectDir)+'"')
    else
     Writeln(t,ext,' -verbose 2 -windowgui -devmode -dispstats -debug log -displayconfig -path '+prjdir);
    CloseFile(t);
   end;

  if ShellExecute(Handle,nil,Pchar(batname),nil,Pchar(GameDir),SW_SHOW)<32 then
   PanMessage(mt_error,'Couldn''t start JK/MOTS');

 end;
end;



