procedure TJedMain.ExportSectorasShape1Click(Sender: TObject);
var s:string;
begin
 s:='';
 if not InputQuery('New Shape Name','Name:',s) then exit;
 s:=trim(s);
 if s='' then exit;
 AddPrefab(s,Level.Sectors[Cur_SC]);
 SavePrefabs(BaseDir+'JedData\shapes.tpl');
 ToolBar.UpdatePrefabs;
end;

procedure TJedMain.ExportSectorsasOBJ1Click(Sender: TObject);
var sel:TArray<Integer>;
    i:integer;

Procedure AddSel(n:integer);
var k:integer;
begin
 if (n<0) or (n>=Level.Sectors.Count) then exit;
 for k:=0 to High(sel) do if sel[k]=n then exit;
 SetLength(sel,Length(sel)+1);
 sel[High(sel)]:=n;
end;

begin
 SetLength(sel,0);
 for i:=0 to scsel.Count-1 do AddSel(scsel.GetSC(i));
 AddSel(Cur_SC);
 ObjExport.SetSelection(sel);
 ObjExport.ShowModal;
end;

